# Local runtime/backup artifacts
:memory:
*.bak
artifacts/terminal_*.jsonl
artifacts/open_prep/outcomes/*.json
# …but allow the daily outcomes_<date>.json files that the
# run-open-prep-daily / outcome-backfill workflows commit,
# since they are the FI-corpus source of truth on main.
!artifacts/open_prep/outcomes/outcomes_*.json
# Local run_open_prep shadow (OPEN_PREP_OUTCOMES_DIR) — keeps local outcome
# writes off the CI-committed canonical dir above (no untracked pull collisions).
artifacts/open_prep/outcomes_local/

# TradingView Playwright automation artifacts.
# Ignore the auth dir WHOLESALE: it holds live session cookies and browser
# profiles (storage-state*.json, chromium-profile/, chrome-clone-profile/, …).
# Exact-name rules proved leaky — new byproducts (e.g. a cloned Chrome profile
# with Cookies/Login Data) were one `git add -A` away from being committed.
automation/tradingview/auth/
automation/tradingview/reports/screenshots/
automation/tradingview/reports/*.json
playwright/.auth/
node_modules/
.tmp_*.mjs

# Databento generated cache/runtime artifacts
artifacts/databento_volatility_cache/
artifacts/databento_reference_cache/
databento_volatility_production_*.xlsx

# Local editor MCP server config (may contain tokens)
.vscode/mcp.json

# Local NewsAPI / shared-news probe and cache artifacts
artifacts/manual_newsapi_*/
artifacts/newsapi_ai/
artifacts/shared_news_cache/

# Generator intermediate outputs (created by refresh_generated_artifacts)
data/output/

# Temporary structure artifacts from tests
reports/_tmp_structure_*/
reports/smc_structure_artifacts/
reports/smc_snapshot_bundles/

# Per-run open_prep dashboard outputs (timestamped HTML/CSV/JSON snapshots
# produced by `python -m open_prep …` and the streamlit dashboard runs).
# These accumulate without bound on contributor machines and CI hosts and
# show up as ever-growing untracked drift in `git status`. They are not
# part of the canonical artifact corpus.
reports/open_prep_lists_*.html
reports/open_prep_lists_*.csv
reports/open_prep_full_run_*.json
reports/open_prep_compare_*.json
reports/open_prep_ranked_candidates_*.csv
reports/open_prep_trade_cards_*.csv
artifacts/smc_microstructure_exports/
artifacts/tradingview/*.json
artifacts/ops_run_report.json
artifacts/ops_run_stdout*.txt
artifacts/ops_run_time*.txt
artifacts/tmp_*.py
artifacts/ops_run_measure.py

# Local research scratch archive (ensemble/regime study 2026-07 — dumps, logs,
# per-run JSON; ~5k files). Kept local, never committed. See memory + the
# artifacts/research/ensemble_2026-07/README for provenance.
artifacts/research/

# Editable-install metadata (added 2026-04-23 with pyproject [tool.setuptools] block)
*.egg-info/

