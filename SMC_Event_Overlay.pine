//@version=6

// Product role: companion_operator_only. Pro-only event-risk overlay outside the Lite default surface.

// ─────────────────────────────────────────────────────────────────
// SMC Event Overlay — lightweight optional companion to SMC Core
//
// Draws three visual elements for relevant macro/earnings events:
//   1. Vertical line at the exact event time (America/New_York, DST-aware)
//   2. Separate pre/post-event restriction zone (bgcolor shading)
//   3. Compact event label with name + impact + published event time
//
// Does NOT duplicate any core logic. Reads:
//   • smc_micro_profiles_generated library — static event metadata
//   • BUS LeanPackA (from Engine) — canonical lean event-risk state in slot 2
//
// Keep on a separate pane or overlay — it is independent of trade signals.
// ─────────────────────────────────────────────────────────────────

indicator("SMC Event Overlay", overlay = true, max_labels_count = 50, max_lines_count = 50, max_boxes_count = 50)

import preuss_steffen/smc_micro_profiles_generated/184 as mp
import preuss_steffen/smc_utils/4 as u

// ── Inputs ──────────────────────────────────────────────────────

var g_ev = "Event Overlay"
var bool show_event_line       = input.bool(true,  "Show exact event-time line", group = g_ev, tooltip = "Draws NEXT_EVENT_TIME at its absolute America/New_York timestamp. This is not the start of the restriction window.")
var bool show_event_zone       = input.bool(true,  "Show pre/post event zone",   group = g_ev)
var bool show_event_label      = input.bool(true,  "Show event label",           group = g_ev)
var bool high_impact_only      = input.bool(true,  "High-impact events only",    group = g_ev, tooltip = "When enabled, only HIGH and ELEVATED impact events are shown.")
var color col_event_line       = input.color(color.new(color.orange, 20), "Event line color",  group = g_ev)
var color col_zone_pre         = input.color(color.new(color.orange, 88), "Pre-event zone",    group = g_ev)
var color col_zone_post        = input.color(color.new(color.red, 88),    "Post-event zone",   group = g_ev)
var color col_label_text       = input.color(color.white,                 "Label text color",  group = g_ev)
src_lean_pack_a                = input.source(close, "BUS LeanPackA",     group = g_ev, tooltip = "Connect to 'BUS LeanPackA' output of SMC Core.")

var g_alerts = "Alerts"
var bool barCloseOnly          = input.bool(true,  "Alerts nur am Bar-Close",  group = g_alerts, tooltip = "Wenn aktiv, feuern Alerts nur auf bestätigten (geschlossenen) Bars. Verhindert Repaint/Flicker während der laufenden Bar.")

// ── Library fields (static per refresh) ─────────────────────────

string ev_window      = mp.EVENT_WINDOW_STATE      // CLEAR | PRE_EVENT | POST_EVENT | COOLDOWN
string ev_risk_level  = mp.EVENT_RISK_LEVEL         // NONE | LOW | ELEVATED | HIGH
string ev_name        = mp.NEXT_EVENT_NAME
string ev_time        = mp.NEXT_EVENT_TIME
string ev_impact      = mp.NEXT_EVENT_IMPACT        // NONE | LOW | MEDIUM | HIGH
int    ev_before_min  = mp.EVENT_RESTRICT_BEFORE_MIN
int    ev_after_min   = mp.EVENT_RESTRICT_AFTER_MIN
bool   ev_cooldown    = mp.EVENT_COOLDOWN_ACTIVE
bool   ev_mkt_block   = mp.MARKET_EVENT_BLOCKED
bool   ev_sym_block   = mp.SYMBOL_EVENT_BLOCKED
string ev_risk_tickers = mp.HIGH_RISK_EVENT_TICKERS
string ev_earnings_tickers = mp.EARNINGS_SOON_TICKERS

// Library freshness check (shared pattern across all companions)
var label stale_badge = na
if barstate.islast
    float asof_year  = str.tonumber(str.substring(mp.ASOF_DATE, 0, 4))
    float asof_month = str.tonumber(str.substring(mp.ASOF_DATE, 5, 7))
    float asof_day   = str.tonumber(str.substring(mp.ASOF_DATE, 8, 10))
    int asof_ts      = timestamp(int(asof_year), int(asof_month), int(asof_day))
    int days_old     = math.floor((timenow - asof_ts) / 86400000)
    if days_old > 2
        if not na(stale_badge)
            label.delete(stale_badge)
        stale_badge := label.new(bar_index, low,
            "⚠ Library " + str.tostring(days_old) + "d old",
            color = color.new(color.red, 40), textcolor = color.white,
            style = label.style_label_up, size = size.tiny)

// ── BUS decode helpers ──────────────────────────────────────────

pack_slot(float packed_value, int slot) =>
    int packed = int(math.round(nz(packed_value, 0.0)))
    if slot == 0
        int(math.floor(packed / 1000000000.0))
    else if slot == 1
        int(math.floor(packed / 1000000.0)) % 1000
    else if slot == 2
        int(math.floor(packed / 1000.0)) % 1000
    else
        packed % 1000

row_status(int row_code) =>
    int(math.floor(row_code / 100)) - 1

row_reason(int row_code) =>
    row_code % 100

lean_erl_row_code() =>
    pack_slot(src_lean_pack_a, 2)

overlay_event_status_text(int lean_row_code) =>
    int lean_state = row_status(lean_row_code)
    int lean_reason = row_reason(lean_row_code)
    if lean_state == -1 and lean_reason == 1
        "🚫 Mkt Block"
    else if lean_state == -1 and lean_reason == 6
        "🚫 Earn Block"
    else if lean_state == 2 and lean_reason == 3
        "⏳ Incoming"
    else if lean_state == 3 and lean_reason == 4
        "❄ Cooldown"
    else
        "✓ Clear"

event_timestamp_et(string asof_date, string event_time) =>
    float event_year = str.tonumber(str.substring(asof_date, 0, 4))
    float event_month = str.tonumber(str.substring(asof_date, 5, 7))
    float event_day = str.tonumber(str.substring(asof_date, 8, 10))
    float event_hour = str.tonumber(str.substring(event_time, 0, 2))
    float event_minute = str.tonumber(str.substring(event_time, 3, 5))
    bool valid_parts = not na(event_year) and not na(event_month) and not na(event_day) and
         not na(event_hour) and not na(event_minute) and str.length(event_time) >= 5 and
         str.substring(event_time, 2, 3) == ":" and event_hour >= 0 and event_hour <= 23 and
         event_minute >= 0 and event_minute <= 59
    valid_parts ? timestamp("America/New_York", int(event_year), int(event_month), int(event_day), int(event_hour), int(event_minute)) : na

// ── Visibility gate ─────────────────────────────────────────────

bool has_event       = ev_name != ""
bool is_high_impact  = ev_impact == "HIGH" or ev_impact == "MEDIUM" or ev_risk_level == "HIGH" or ev_risk_level == "ELEVATED"
bool show_any        = has_event and (not high_impact_only or is_high_impact)
bool is_symbol_event = u.csv_has_symbol_token(ev_risk_tickers, syminfo.ticker, syminfo.tickerid) or u.csv_has_symbol_token(ev_earnings_tickers, syminfo.ticker, syminfo.tickerid)
bool is_blocked      = ev_mkt_block or (ev_sym_block and is_symbol_event)
int event_ts         = event_timestamp_et(mp.ASOF_DATE, ev_time)
bool event_time_valid = not na(event_ts)
int restriction_start_ts = event_time_valid ? event_ts - ev_before_min * 60000 : na
int restriction_end_ts   = event_time_valid ? event_ts + ev_after_min * 60000 : na
int bar_end_ts            = na(time_close) ? time : time_close
bool in_pre_restriction   = show_any and event_time_valid and time < event_ts and bar_end_ts > restriction_start_ts
bool in_post_restriction  = show_any and event_time_valid and time <= restriction_end_ts and bar_end_ts > event_ts
bool fallback_restriction = show_any and not event_time_valid and ev_window != "CLEAR" and barstate.islast

// ── 1. Pre/Post event zone (bgcolor) ────────────────────────────

color zone_color = show_event_zone ?
     in_pre_restriction ? col_zone_pre :
     in_post_restriction ? col_zone_post :
     fallback_restriction and ev_window == "PRE_EVENT" ? col_zone_pre :
     fallback_restriction ? col_zone_post :
     na :
     na

bgcolor(zone_color, title = "Event Zone")

// ── 2. Exact event-time line ───────────────────────────────────

// The generated snapshot is static across chart history. Anchor the object to
// the published event timestamp instead of treating the first PRE_EVENT bar as
// an event-time series transition.
if barstate.islastconfirmedhistory and show_event_line and show_any and event_time_valid
    line.new(event_ts, high, event_ts, low, xloc.bar_time, extend.both,
         col_event_line, line.style_dashed, 1)

// ── 3. Compact event label ─────────────────────────────────────

if barstate.islastconfirmedhistory and show_event_label and show_any and event_time_valid
    string impact_icon = ev_impact == "HIGH" ? "⚠" : ev_impact == "MEDIUM" ? "●" : "○"
    string block_flag  = is_blocked ? " 🚫" : ""
    string lbl_text    = impact_icon + " " + ev_name + " @ " + ev_time + block_flag
    label.new(event_ts, high, lbl_text,
         xloc.bar_time, yloc.abovebar,
         color   = is_blocked ? color.red : color.new(color.orange, 30),
         style   = label.style_label_down,
         textcolor = col_label_text,
         size    = size.small)

// ── Status bar (bottom-right compact) ───────────────────────────
// Minimal real-time status from BUS — one static plot per possible state.
// Pine requires plotchar.char to be an input string, so a dynamic series string
// cannot be passed into a single plotchar call.

int rt_lean_row_code = lean_erl_row_code()
int rt_lean_state = row_status(rt_lean_row_code)
int rt_lean_reason = row_reason(rt_lean_row_code)
bool rt_market_block = rt_lean_state == -1 and rt_lean_reason == 1
bool rt_earnings_block = rt_lean_state == -1 and rt_lean_reason == 6
bool rt_incoming = rt_lean_state == 2 and rt_lean_reason == 3
bool rt_cooldown = rt_lean_state == 3 and rt_lean_reason == 4
bool rt_clear = not rt_market_block and not rt_earnings_block and not rt_incoming and not rt_cooldown

plotchar(show_any and rt_market_block ? 0 : na, "Event Status · Market Block", "M", location.bottom, size = size.tiny, display = display.status_line)
plotchar(show_any and rt_earnings_block ? 0 : na, "Event Status · Earnings Block", "E", location.bottom, size = size.tiny, display = display.status_line)
plotchar(show_any and rt_incoming ? 0 : na, "Event Status · Incoming", "I", location.bottom, size = size.tiny, display = display.status_line)
plotchar(show_any and rt_cooldown ? 0 : na, "Event Status · Cooldown", "C", location.bottom, size = size.tiny, display = display.status_line)
plotchar(show_any and rt_clear ? 0 : na, "Event Status · Clear", "✓", location.bottom, size = size.tiny, display = display.status_line)

// ── Alerts ──────────────────────────────────────────────────────
_alertGate = barCloseOnly ? barstate.isconfirmed : true
bool restriction_just_started = show_any and event_time_valid and time <= restriction_start_ts and bar_end_ts > restriction_start_ts

alertcondition(restriction_just_started and is_blocked and _alertGate,
     title = "Event Restriction Hard Block Started",
     message = "🚫 Event restriction window started: {{ticker}} — " + ev_name)

alertcondition(restriction_just_started and not is_blocked and _alertGate,
     title = "Event Restriction Window Started",
     message = "⏳ Event restriction window started: {{ticker}} — " + ev_name + " (" + ev_impact + ")")
