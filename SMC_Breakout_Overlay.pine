//@version=6

// Product role: companion_operator_only.
//
// SMC Breakout Overlay — LonesomeTheBlue-style breakout/breakdown boxes.
//
// DUAL-MODE structure source:
//
//   • ENGINE-BOUND (preferred): bind the four "BUS …" inputs to SMC Core's
//     hidden per-bar plots (SchemaVersion / ZoneActive / Trigger / Invalidation).
//     When the schema reads 7001 the engine is present, and its OWN
//     trigger/invalidation levels drive the boxes — so the overlay agrees with
//     the engine instead of forming a second, independent opinion. A close
//     crossing the engine's Trigger is the engine's breakout; crossing its
//     Invalidation is the breakdown. Boxes anchor to when the setup zone
//     became active.
//
//   • LOCAL-PIVOT FALLBACK: when engine binding is off, unbound, or the engine
//     is not on the chart (schema mismatch), structure and the active
//     support/resistance are computed locally from swing pivots, and breaks are
//     classified as BOS (continuation) vs CHoCH (reversal).
//
// It does NOT import the smc_micro_profiles library — that library is a
// per-symbol SNAPSHOT (baked constants, self-attesting LIBRARY_STRUCTURE_MISSING),
// not the per-bar structure series a breakout renderer needs, so the old
// `mp.BOS_BULL` / `mp.ACTIVE_RESISTANCE` fields never existed and never compiled.
// Per-bar structure comes from the engine BUS (bindable) or local pivots.
//
// BOS   = a break that CONTINUES the prevailing trend   (pivot mode only).
// CHoCH = a break that REVERSES it (change of character) (pivot mode only).
//
// Box height = threshold% of the most-recent N-bar range (LonesomeTheBlue idea).

indicator("SMC Breakout Overlay", overlay = true,
     max_lines_count = 100, max_labels_count = 200, max_boxes_count = 500, max_bars_back = 500)

// ── Inputs ──────────────────────────────────────────────────────
// Note: input.*() and group-name literals are evaluated once and are const by
// construction — no `var` needed (matches the SMC dashboard's input style and
// keeps the per-file var-declaration budget for genuine cross-bar state only).

g_mode = "Engine binding"
bool bindEngine = input.bool(true, "Bind to SMC engine BUS (else local pivots)", group = g_mode,
     tooltip = "ON + the four BUS sources bound to SMC Core's hidden plots → the engine's own " +
     "Trigger/Invalidation levels drive the boxes. OFF, unbound, or engine not on chart " +
     "(schema ≠ 7001) → fall back to local swing pivots.")
src_schema       = input.source(close, "BUS SchemaVersion", group = g_mode, display = display.none,
     tooltip = "Bind to SMC Core's 'BUS SchemaVersion' plot. Must read 7001 for engine mode to activate.")
src_zone_active  = input.source(close, "BUS ZoneActive",  group = g_mode, display = display.none)
src_trigger      = input.source(close, "BUS Trigger",      group = g_mode, display = display.none)
src_invalidation = input.source(close, "BUS Invalidation", group = g_mode, display = display.none)

int  expected_bus_version = 7001   // matches SMC Core's published 'BUS SchemaVersion'
bool engine_bound = bindEngine and math.round(src_schema) == expected_bus_version

g_trig = "Triggers (local-pivot mode)"
bool use_bos   = input.bool(true,  "Trigger on BOS",   group = g_trig)
bool use_choch = input.bool(true,  "Trigger on CHoCH", group = g_trig)
int  pivLen    = input.int(5,      "Swing strength (pivot bars)", minval = 2, maxval = 50, group = g_trig,
     tooltip = "Left/right bars for the swing pivots that define structure and the active S/R levels.")
int  minHold   = input.int(5,      "Min level age (bars)", minval = 1, maxval = 200, group = g_trig,
     tooltip = "Skip boxes where the broken swing was established fewer than N bars ago — filters noise. " +
     "Not applied in engine mode (the engine already gates its own setup).")

g_box  = "Box geometry"
int   rangeLen = input.int(300, "Range lookback (bars)",  minval = 30, maxval = 500, group = g_box,
     tooltip = "Window used to compute the threshold band height (LonesomeTheBlue uses 300).")
float thrPct   = input.float(3.0, "Threshold band %",     minval = 0.5, maxval = 10.0, step = 0.5, group = g_box,
     tooltip = "Box height as % of the lookback-window range.") / 100.0

g_vis  = "Visuals"
color  colUp   = input.color(color.new(color.blue, 0), "Breakout (bull) color",  group = g_vis)
color  colDn   = input.color(color.new(color.red,  0), "Breakdown (bear) color", group = g_vis)
int    lineW   = input.int(1, "Line width", minval = 1, maxval = 4, group = g_vis)
string lstyle  = input.string(line.style_solid, "Line style",
     options = [line.style_solid, line.style_dashed, line.style_dotted], group = g_vis)
bool show_arrows   = input.bool(true, "Show ▲/▼ markers", group = g_vis)
bool show_volemoji = input.bool(true, "Show volume sentiment emoji", group = g_vis,
     tooltip = "🟢 if bull-volume >55% between level establishment and breakout, 🔴 if bear-volume >55%, 🟡 mixed.")

g_sim = "Win/Loss tracker (ATR-RR sim)"
bool  sim_on      = input.bool(true,  "Enable tracker",          group = g_sim)
float rr          = input.float(1.5, "RR ratio",   minval = 0.5, maxval = 5.0, step = 0.1, group = g_sim)
int   atrLen      = input.int(14,    "ATR length", minval = 5,   maxval = 50,  group = g_sim)
float atrMult     = input.float(1.5, "ATR × mult → SL", minval = 0.5, maxval = 5.0, step = 0.1, group = g_sim)
bool  sl_on_close = input.bool(true, "SL on close (else high/low)", group = g_sim)
bool  show_table  = input.bool(true, "Show stats table", group = g_sim)

// ── Structure source A: local swing pivots (ALWAYS computed) ──
// ta.* must be evaluated every bar for a correct series, so pivots are computed
// unconditionally even when the engine is bound; the mode-select below picks
// which source actually drives the boxes. The active resistance is the last
// confirmed swing high, support the last swing low; a pivot confirmed now was
// established `pivLen` bars ago (that bar becomes the box's left edge).

float ph = ta.pivothigh(pivLen, pivLen)
float pl = ta.pivotlow(pivLen, pivLen)

var float piv_resistance = na
var int   piv_res_anchor = na
var float piv_support    = na
var int   piv_sup_anchor = na

if not na(ph)
    piv_resistance := ph
    piv_res_anchor := bar_index - pivLen
if not na(pl)
    piv_support := pl
    piv_sup_anchor := bar_index - pivLen

// ── Structure source B: SMC engine BUS (optional) ──
// `zone_start_bar` = the bar the current setup zone became active; it anchors
// the box's left edge in engine mode (analog of the swing-high bar in pivots).

bool zone_on = src_zone_active > 0.5
var int zone_start_bar = na
if zone_on and na(zone_start_bar)
    zone_start_bar := bar_index
if not zone_on
    zone_start_bar := na

// ── Mode-select: which source drives the boxes this bar ──
// Engine mode: the engine's own Trigger/Invalidation levels, but only while a
// setup zone is active (no zone → no level → no box). Pivot mode: local swings.
float resistance     = engine_bound ? (zone_on ? src_trigger : na)      : piv_resistance
float support        = engine_bound ? (zone_on ? src_invalidation : na) : piv_support
int   res_anchor_bar = engine_bound ? zone_start_bar : piv_res_anchor
int   sup_anchor_bar = engine_bound ? zone_start_bar : piv_sup_anchor

// ── Break detection + pivot-mode classification ──
// trend: +1 after a bullish break, -1 after a bearish break, 0 until the first.
// bos_/choch_ are meaningful only in pivot mode (engine mode uses plain labels).

bool broke_up = not na(resistance) and ta.crossover(close, resistance)
bool broke_dn = not na(support)    and ta.crossunder(close, support)

var int trend = 0
bool bos_bull   = broke_up and trend >= 0
bool choch_bull = broke_up and trend <  0
bool bos_bear   = broke_dn and trend <= 0
bool choch_bear = broke_dn and trend >  0
if broke_up
    trend := 1
if broke_dn
    trend := -1

// ── Threshold band height (LonesomeTheBlue formula) ────────────
// `rangeLen` is a simple int (input), so ta.highest/ta.lowest accept it; on
// early bars Pine simply uses the fewer bars available.

float chwidth = (ta.highest(high, rangeLen) - ta.lowest(low, rangeLen)) * thrPct

// ── Volume-sentiment emoji (ChartPrime-style) ──────────────────
// Sums green vs. red bar volume between `from_bar` and the current bar.
// Returns 🟢 / 🔴 / 🟡.

vol_sentiment(int from_bar) =>
    // Cap span to a safe lookback so we never index beyond `max_bars_back`
    // and never run an unbounded loop when an anchor persists for thousands
    // of bars (would cause runtime errors / severe slowdowns).
    int VOL_LOOKBACK_MAX = 500
    int raw_span = math.max(bar_index - from_bar, 1)
    int span = math.min(raw_span, VOL_LOOKBACK_MAX)
    float green_sum = 0.0
    float red_sum   = 0.0
    float total_sum = 0.0
    for i = 0 to span - 1
        float v = nz(volume[i])
        total_sum += v
        if close[i] > open[i]
            green_sum += v
        else if close[i] < open[i]
            red_sum += v
    float gr = total_sum > 0 ? green_sum / total_sum * 100.0 : 0.0
    float rr_ = total_sum > 0 ? red_sum   / total_sum * 100.0 : 0.0
    gr > 55.0 ? "🟢" : rr_ > 55.0 ? "🔴" : "🟡"

// ── Trigger evaluation ─────────────────────────────────────────
// H-1 follow-up (PR #1940 review): the trigger booleans drive both the
// alertcondition gate AND plotshape / sim. If we let them flicker intrabar,
// a mid-bar wick can fire a box without the alert ever confirming. Anchor the
// truth to `barstate.isconfirmed` once at the source so every downstream
// consumer (alerts, plotshape, sim) stays aligned.
bool _trig_confirmed = barstate.isconfirmed

// Structure filter: engine mode accepts every level break (the engine already
// validated the setup); pivot mode applies the BOS/CHoCH toggles.
bool struct_bull_ok = engine_bound ? true : ((use_bos and bos_bull) or (use_choch and choch_bull))
bool struct_bear_ok = engine_bound ? true : ((use_bos and bos_bear) or (use_choch and choch_bear))

// Level-age filter applies only to locally-detected pivots; engine levels are
// already setup-gated, so age is not re-checked there.
bool age_bull_ok = engine_bound ? true : (not na(res_anchor_bar) and (bar_index - res_anchor_bar) >= minHold)
bool age_bear_ok = engine_bound ? true : (not na(sup_anchor_bar) and (bar_index - sup_anchor_bar) >= minHold)

bool trig_bull = _trig_confirmed and broke_up and struct_bull_ok and age_bull_ok
bool trig_bear = _trig_confirmed and broke_dn and struct_bear_ok and age_bear_ok

// ── Draw box (single box.new — proper object lifecycle, no max_lines spam) ─

draw_box(int x1, float y_top, float y_bot, int x2, color col) =>
    // Use box.new so each breakout produces ONE managed object instead of 4
    // permanently allocated `line` objects (would silently hit max_lines_count
    // and stop drawing after enough triggers).
    box.new(left = x1, top = y_top, right = x2, bottom = y_bot,
         border_color = col, border_width = lineW, border_style = lstyle,
         bgcolor = color.new(col, 90))

// Label text helper: "<base> 🟢" — base tag already resolved for the mode.
breakout_label(string base_tag, int from_bar) =>
    string emo = show_volemoji ? " " + vol_sentiment(from_bar) : ""
    base_tag + emo

if trig_bull
    int   x1    = na(res_anchor_bar) ? math.max(bar_index - 1, 0) : res_anchor_bar
    float y_top = resistance
    float y_bot = resistance - chwidth
    draw_box(x1, y_top, y_bot, bar_index, colUp)
    string base = engine_bound ? "LONG TRIGGER" : (choch_bull ? "CHoCH" : "BOS")
    label.new(int(math.avg(x1, bar_index)), y_top, breakout_label(base, x1),
         color = color.new(colUp, 70), textcolor = color.white,
         style = label.style_label_down, size = size.tiny)

if trig_bear
    int   x1    = na(sup_anchor_bar) ? math.max(bar_index - 1, 0) : sup_anchor_bar
    float y_bot = support
    float y_top = support + chwidth
    draw_box(x1, y_top, y_bot, bar_index, colDn)
    string base = engine_bound ? "INVALIDATION" : (choch_bear ? "CHoCH" : "BOS")
    label.new(int(math.avg(x1, bar_index)), y_bot, breakout_label(base, x1),
         color = color.new(colDn, 70), textcolor = color.white,
         style = label.style_label_up, size = size.tiny)

// ── Markers (▲ below / ▼ above the breakout bar) ───────────────

plotshape(show_arrows and trig_bull, "SMC Breakout",  shape.triangleup,
     location.belowbar, colUp, size = size.small)
plotshape(show_arrows and trig_bear, "SMC Breakdown", shape.triangledown,
     location.abovebar, colDn, size = size.small)

// ── Alerts ─────────────────────────────────────────────────────
// H-1 (system review 2026-04-24): every alertcondition() must be gated
// against intra-bar firing. _alertGate is the canonical token the audit
// pin (tests/test_pine_alert_bar_close_gate.py) recognises.
_alertGate = barstate.isconfirmed
alertcondition(_alertGate and trig_bull, title = "SMC Breakout",
     message = "SMC Breakout — close broke the resistance / engine long-trigger.")
alertcondition(_alertGate and trig_bear, title = "SMC Breakdown",
     message = "SMC Breakdown — close broke the support / engine invalidation.")
alertcondition(_alertGate and (trig_bull or trig_bear), title = "SMC Breakout or Breakdown",
     message = "SMC Breakout or Breakdown")

// ── Win/Loss tracker (ATR-RR simulation) ───────────────────────
// Mirrors ChartPrime's idea: when a breakout/breakdown fires, open a
// virtual trade with SL = ATR×mult, TP = SL×RR, and tally hit/miss.
// Pure rendering — not connected to the real strategy engine.

float atr_v  = ta.atr(atrLen)
float sl_dist = atr_v * atrMult

var bool  sim_active   = false
var bool  sim_long     = false
var float sim_tp       = na
var float sim_sl       = na
var int   sim_wins     = 0
var int   sim_losses   = 0

if sim_on and not sim_active and (trig_bull or trig_bear)
    sim_active := true
    sim_long   := trig_bull
    if sim_long
        sim_sl := close - sl_dist
        sim_tp := close + sl_dist * rr
    else
        sim_sl := close + sl_dist
        sim_tp := close - sl_dist * rr

if sim_on and sim_active
    float sl_probe = sl_on_close ? close : (sim_long ? low  : high)
    float tp_probe =                 (sim_long ? high : low )
    bool tp_hit = sim_long ? (tp_probe >= sim_tp) : (tp_probe <= sim_tp)
    bool sl_hit = sim_long ? (sl_probe <= sim_sl) : (sl_probe >= sim_sl)
    if tp_hit
        sim_wins  += 1
        sim_active := false
    else if sl_hit
        sim_losses += 1
        sim_active := false

int   sim_total = sim_wins + sim_losses
float sim_wr    = sim_total > 0 ? sim_wins / float(sim_total) * 100.0 : 0.0

var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.gray, 80),
     border_width = 1, border_color = color.new(color.gray, 60))

if show_table and sim_on and barstate.islast
    table.cell(tb, 0, 0, "SMC BO Sim (RR " + str.tostring(rr, "#.0") + ")",
         text_color = color.new(color.white, 0), bgcolor = color.new(color.gray, 60))
    table.cell(tb, 1, 0, "", bgcolor = color.new(color.gray, 60))
    table.cell(tb, 0, 1, "Source", text_color = color.new(color.silver, 0))
    table.cell(tb, 1, 1, engine_bound ? "Engine" : "Pivots",
         text_color = engine_bound ? color.new(#08c09b, 0) : color.new(color.silver, 0))
    table.cell(tb, 0, 2, "Wins",   text_color = color.new(color.silver, 0))
    table.cell(tb, 1, 2, str.tostring(sim_wins),   text_color = color.new(#08c09b, 0))
    table.cell(tb, 0, 3, "Losses", text_color = color.new(color.silver, 0))
    table.cell(tb, 1, 3, str.tostring(sim_losses), text_color = color.new(#cd0202, 0))
    table.cell(tb, 0, 4, "Win %",  text_color = color.new(color.silver, 0))
    table.cell(tb, 1, 4, str.tostring(sim_wr, "#.0") + "%",
         text_color = sim_wr >= 50.0 ? color.new(#08c09b, 0) : color.new(#cd0202, 0))
