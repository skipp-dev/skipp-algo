//@version=6
// @description SMC live context library (bus-v3 track). Derives per-bar domain
// frames from the engine primitives instead of the dead per-symbol snapshot:
// StructureFrame (BOS/CHoCH/trend/S-R via eng.detect_structure), ImbalanceFrame
// (FVG lifecycle + BPR + liquidity void via eng.fvgs_objects) and ZoneFrame
// (order-block lifecycle via eng.track_obs). Detection is the engine's SSOT in
// all three and is NOT golden-gated against Python. The imbalance rule layer
// (mitigation %, BPR overlap, void %, zone-bias count delta, state precedence)
// mirrors the golden parity contract in tests/fixtures/smc_context_golden.json;
// structure and zone are spec-only (Column B) — see docs/smc-context-semantics.md.
// Sweep/Pool frames and the aggregated build_context_frame() follow in later
// slices: sweeps and pools do have a Python golden for their *scoring*, but their
// live candidate detection has no engine primitive and is genuinely new Pine work.
library("smc_context_engine_private", overlay = true)

// Pine requires every library referenced by a *used* type's fields to be imported
// (CE10293), and those libraries must come before the engine that pulls them into
// its types — so the engine is imported last, matching SMC_Long_Dip_Suite.
//   ct  — eng.FVG and eng.OrderBlock declare ct.LevelBreakMode fields.
//   d   — both declare d.SmcBox / d.SmcLine / d.SmcLabel fields.
//   pe  — eng.OrderBlock declares a pe.Profile field. NOTHING here calls pe.*:
//         build_zone_frame leaves every profile feature off, so the engine never
//         creates a Profile. Kept a narrow type edge by the allowlist in
//         tests/test_pine_library_import_permissions.py and enforced by
//         tests/test_pine_context_library_contract.py.
//   u   — smc_lib_atr for the OB size filter. A real call; public library.
import preuss_steffen/smc_core_types/5 as ct
import preuss_steffen/smc_utils/3 as u
import preuss_steffen/smc_draw/3 as d
import preuss_steffen/smc_profile_engine/2 as pe
import preuss_steffen/smc_engine_private/1 as eng

// ─────────────────────────────────────────────────────────────────────────────
// Rule-layer thresholds.
//
// These are REAL constants, not comments, and they carry the exact names used in
// tests/fixtures/smc_context_golden.json._meta.thresholds. That is deliberate:
// tests/test_pine_context_library_contract.py parses the declarations below and
// asserts each value equals the frozen golden. Previously these numbers were
// inlined at their use-sites with the names only in comments — so the Python
// reference could move, the golden would regenerate, every Python test would stay
// green, and this library would be silently wrong. A comment cannot be checked;
// a named const can.
// ─────────────────────────────────────────────────────────────────────────────

// --- golden-checked (names must match _meta.thresholds) ---
const float PARTIAL_MIT_PCT       = 0.5   // gap filled >= 50% -> partial mitigation
const float FULL_MIT_PCT          = 1.0   // gap fully closed  -> no longer active.
                                          // Handed to the engine as the FVG fill
                                          // target, which is what makes
                                          // eng.FVG.filled mean "fully mitigated".
const float LIQ_VOID_MIN_SIZE_PCT = 2.0   // gap >= 2% of mid  -> liquidity void

// --- Pine-only (Column B spec, no Python golden) ---
const int   ZONE_BIAS_COUNT_DELTA = 2     // |bull-bear count| >= 2 -> directional bias
                                          // (ImbalanceFrame.zone_bias over FVGs,
                                          //  ZoneFrame.ob_bias over order blocks)

// --- Zone-frame OB size filter — mirrors SMC_Long_Dip_Suite.pine lines 904-906 ---
const int   ATR_LEN_MAIN          = 50    // u.smc_lib_atr length. NOT 200 — that is
                                          // an unrelated engine-internal impulse ATR.
const float OB_FILTER_MIN_MULT    = 0.5   // min block size = atr * 0.5
const float OB_FILTER_MAX_MULT    = 2.5   // max block size = atr * 2.5

// ── Frame types ──────────────────────────────────────────────────────────────

// Per-bar structure state. Prices are `na` (never 0) when unavailable; anchor
// bar indices are `na` when there is no pivot. `trend` persists between events.
//
// Confirmed-bar only: the frame is rebuilt when barstate.isconfirmed and held
// between ticks, so every field describes the last CLOSED bar. The engine's
// BOS/CHoCH alerts fire intrabar and can vanish before the close, which is why
// the Suite gates the same alerts through resolve_confirmed_signal.
export type StructureFrame
    int    trend             // +1 bullish, -1 bearish, 0 unknown (no confirmed event yet)
    bool   bos               // a BOS fired on this confirmed bar (either side)
    bool   choch             // a CHoCH fired on this confirmed bar (either side)
    int    dir_event         // +1 bullish event, -1 bearish event, 0 none (this bar)
    float  resistance        // active trailing swing high level
    float  support           // active trailing swing low level
    int    resistance_x      // bar_index anchor of the last swing-high pivot
    int    support_x         // bar_index anchor of the last swing-low pivot
    int    bars_since_event  // age: confirmed bars since the last BOS/CHoCH (na until first)
    bool   fresh             // event age within the freshness window

// Per-bar imbalance state (FVG lifecycle + BPR + liquidity void). Prices `na`
// when inactive; counts default 0. `state`: 0 NONE, 1 FVG_BULL, 2 FVG_BEAR,
// 3 BPR, 4 LIQ_VOID (precedence BPR > VOID > FVG_BULL > FVG_BEAR > NONE).
export type ImbalanceFrame
    bool   bull_fvg_active
    bool   bear_fvg_active
    float  bull_fvg_top
    float  bull_fvg_bottom
    float  bear_fvg_top
    float  bear_fvg_bottom
    float  bull_fvg_mit_pct  // engine fill_current_ratio of the newest active bull FVG
    float  bear_fvg_mit_pct
    bool   bull_fvg_partial  // mit_pct >= 0.5
    bool   bear_fvg_partial
    int    bull_fvg_count    // active bull FVGs
    int    bear_fvg_count
    bool   bpr_active
    int    bpr_dir           // +1 bull, -1 bear, 0 none
    float  bpr_top
    float  bpr_bottom
    bool   liq_void_active
    float  liq_void_top
    float  liq_void_bottom
    int    zone_bias         // +1 bull, -1 bear, 0 neutral (FVG count-delta rule)
    int    state             // composite code, see above

// Per-bar order-block state (eng.track_obs lifecycle). Direction-neutral: the v2
// engine bus carries only the product's best *bull* OB, this frame reports both
// sides. Prices/ids are `na` when that side has no active OB; counts default 0.
// `state`: 0 NONE, 1 OB_BULL, 2 OB_BEAR, 3 OB_BOTH (precedence BOTH > BULL >
// BEAR > NONE). `*_new` / `*_broken` are edges — true only on the event bar.
// `ob_bias` is the OB count delta and is NOT ImbalanceFrame.zone_bias (FVGs).
export type ZoneFrame
    bool   bull_ob_active
    bool   bear_ob_active
    int    bull_ob_id        // newest active bull OB (engine id)
    int    bear_ob_id
    float  bull_ob_top
    float  bull_ob_bottom
    float  bear_ob_top
    float  bear_ob_bottom
    int    bull_ob_count     // active bull OBs
    int    bear_ob_count
    bool   bull_ob_new       // an OB was confirmed on this confirmed bar
    bool   bear_ob_new
    bool   bull_ob_broken    // an OB broke on this confirmed bar
    bool   bear_ob_broken
    int    ob_bias           // +1 bull, -1 bear, 0 neutral (OB count-delta rule)
    int    state             // composite code, see above

// ── Private helpers (defined before the exported builders) ───────────────────

// Newest active FVG in a buffer, by id. Returns [found, top, bottom, mit_pct].
// The engine already keeps only unfilled FVGs in the active buffer; `not filled`
// is a defensive guard. `mit_pct` is the engine's fill_current_ratio.
_newest_active_fvg(array<eng.FVG> arr) =>
    int   best_id = na
    float top     = na
    float bottom  = na
    float mit     = na
    if not na(arr)
        for f in arr
            if not f.filled
                if na(best_id) or f.id > best_id
                    best_id := f.id
                    top     := f.left_top.price
                    bottom  := f.right_bottom.price
                    mit     := f.fill_current_ratio
    [not na(best_id), top, bottom, mit]

// First active FVG whose gap is at least `min_pct`% of `mid`. Returns
// [found, top, bottom]. Mirrors the golden "any FVG >= 2% of mid" void rule.
_first_void(array<eng.FVG> arr, float mid, float min_pct) =>
    bool  found  = false
    float top    = na
    float bottom = na
    if not na(arr) and mid > 0
        for f in arr
            if not f.filled
                float gap_pct = (f.left_top.price - f.right_bottom.price) / mid * 100.0
                if gap_pct >= min_pct
                    found  := true
                    top    := f.left_top.price
                    bottom := f.right_bottom.price
                    break
    [found, top, bottom]

// Newest active order block in a buffer, by id. Returns [found, id, top, bottom].
// The engine removes broken blocks from the tracking buffer inside update_broken,
// so every element here is active by construction — no `broken` guard needed.
// Geometry is the raw left_top/right_bottom: build_zone_frame keeps every profile
// feature off, so no value-area/POC edge alignment is ever applied.
_newest_active_ob(array<eng.OrderBlock> arr) =>
    int   best_id = na
    float top     = na
    float bottom  = na
    if not na(arr)
        for b in arr
            if not na(b)
                if na(best_id) or b.id > best_id
                    best_id := b.id
                    top     := b.left_top.price
                    bottom  := b.right_bottom.price
    [not na(best_id), best_id, top, bottom]

// Project the engine's OB lifecycle onto a ZoneFrame. Takes the structure tuple
// rather than calling eng.detect_structure itself: track_obs must be fed the SAME
// structure instance a caller already has, and this seam lets the aggregated
// build_context_frame() (a later slice) detect structure ONCE instead of spinning
// up a second detector per frame.
_build_zone(simple int swing_len, float hh, float swing_low, bool bull_bos, bool bull_choch, bool bear_bos, bool bear_choch, simple int atr_len, float min_mult, float max_mult) =>
    float atr       = u.smc_lib_atr(atr_len)
    float min_block = atr * min_mult   // OB_FILTER_MIN_MULT
    float max_block = atr * max_mult   // OB_FILTER_MAX_MULT

    // Profile features stay at their `false` defaults, so the engine never builds
    // a pe.Profile — that keeps the pe import a pure type-resolution edge.
    [active_bull, active_bear, new_bull, new_bear, _broken_bull, _broken_bear, broken_new_bull, broken_new_bear, _disc_bull, _disc_bear] = eng.track_obs(swing_len, hh, swing_low, bull_bos, bull_choch, bear_bos, bear_choch, min_block, max_block)

    [has_bull, bull_id, bull_top, bull_bottom] = _newest_active_ob(active_bull)
    [has_bear, bear_id, bear_top, bear_bottom] = _newest_active_ob(active_bear)

    int bull_count = na(active_bull) ? 0 : array.size(active_bull)
    int bear_count = na(active_bear) ? 0 : array.size(active_bear)

    // Edges, not latches: new_* is a per-bar local in the engine (na unless an OB
    // confirmed this bar); broken_new_* is cleared at the top of every update_broken.
    bool bull_new = not na(new_bull)
    bool bear_new = not na(new_bear)
    bool bull_brk = not na(broken_new_bull) and array.size(broken_new_bull) > 0
    bool bear_brk = not na(broken_new_bear) and array.size(broken_new_bear) > 0

    int count_delta = bull_count - bear_count
    int ob_bias     = count_delta >= ZONE_BIAS_COUNT_DELTA ? 1 : count_delta <= -ZONE_BIAS_COUNT_DELTA ? -1 : 0

    // Composite precedence: OB_BOTH > OB_BULL > OB_BEAR > NONE.
    int state = has_bull and has_bear ? 3 : has_bull ? 1 : has_bear ? 2 : 0

    ZoneFrame.new(has_bull, has_bear, has_bull ? bull_id : na, has_bear ? bear_id : na, has_bull ? bull_top : na, has_bull ? bull_bottom : na, has_bear ? bear_top : na, has_bear ? bear_bottom : na, bull_count, bear_count, bull_new, bear_new, bull_brk, bear_brk, ob_bias, state)

// ── Exported builders ────────────────────────────────────────────────────────

// Build the structure frame from the engine's per-bar structure detector.
// `swing_len` is the engine pivot length; `fresh_max_bars` bounds the freshness
// window (bars since the last BOS/CHoCH that still count as "fresh").
export build_structure_frame(simple int swing_len = 50, simple int fresh_max_bars = 20) =>
    // detect_structure carries `var` and `ta.*` state, so it must run on EVERY
    // tick. Never move this call inside the barstate guard below: a conditional
    // call desyncs the engine's internal swing/pivot history.
    [trend, bull_bos, bull_choch, top_x, _top_y, _trail_up_x, trail_up, hh, bear_bos, bear_choch, btm_x, _btm_y, _trail_dn_x, trail_dn, swing_low, _hhll_x] = eng.detect_structure(swing_len)

    // Pivot availability, taken from the engine's own swing output instead of
    // inferred from sentinels. detect_pivot starts at `var x = 0` and
    // `var trail_y = high`, so top_x/btm_x read 0 and trail_up/trail_dn read the
    // running high/low extreme before any swing exists — neither is a pivot, and
    // the frame contract says those are `na`. `x == 0` cannot be the tell: the
    // earliest real pivot lands on bar_index 0 (detect_swings anchors a swing at
    // `bar_index - swing_len`), so a bar-index test would discard a true pivot.
    var bool have_up_pivot = false
    var bool have_dn_pivot = false

    var int bars_since = na

    // The published frame. Built on confirmed bars only; between ticks the
    // caller keeps the last confirmed frame. detect_structure raises its
    // BOS/CHoCH alerts intrabar — the Suite wraps the very same alerts in
    // resolve_confirmed_signal for this reason — so an ungated frame repaints:
    // a cross that reverts before the close would surface as bos = true,
    // dir_event = ±1, bars_since_event = 0, and then vanish at the close.
    var StructureFrame published = StructureFrame.new(0, false, false, 0, na, na, na, na, na, false)

    if barstate.isconfirmed
        if not na(hh)
            have_up_pivot := true
        if not na(swing_low)
            have_dn_pivot := true

        bool bos_now   = bull_bos or bear_bos
        bool choch_now = bull_choch or bear_choch
        bool event_now = bos_now or choch_now
        int  dir_event = (bull_bos or bull_choch) ? 1 : (bear_bos or bear_choch) ? -1 : 0

        if event_now
            bars_since := 0
        else if not na(bars_since)
            bars_since := bars_since + 1

        bool fresh = not na(bars_since) and bars_since <= fresh_max_bars

        // `var trend = 1` in the engine is a bootstrap literal, not a reading:
        // it only ever moves on a CHoCH, so before the first confirmed event
        // every symbol reports "bullish". Publish 0 (unknown) until an event has
        // either confirmed the direction (BOS) or set it (CHoCH).
        bool structure_available = not na(bars_since)

        published := StructureFrame.new(structure_available ? trend : 0, bos_now, choch_now, dir_event, have_up_pivot ? trail_up : na, have_dn_pivot ? trail_dn : na, have_up_pivot ? top_x : na, have_dn_pivot ? btm_x : na, bars_since, fresh)

    published

// Build the imbalance frame (FVG lifecycle + BPR + liquidity void) from the
// engine's object-based FVG tracker. Detection is the engine's; the rule layer
// (mitigation/BPR/void/zone-bias/state) matches the golden parity contract.
export build_imbalance_frame(float size_threshold = 0.0) =>
    // The engine is asked for TERMINAL, WICK-measured fills. Both arguments are
    // the parity contract, not preferences:
    //
    //   fill_target_ratio = FULL_MIT_PCT. The engine retires an FVG once price
    //   reaches `top - ratio*size`, so the previous 0.5 default retired it at the
    //   gap MIDPOINT. Everything downstream read a truncated population:
    //   bull_fvg_partial was unreachable (past 50% the FVG had already left the
    //   active buffer), and count / BPR / liq_void / zone_bias / state were all
    //   computed from it. Deliberately NOT a parameter — a caller lowering it
    //   would silently break the golden contract while every test stayed green.
    //
    //   fill_mode = HIGHLOW. The golden measures mitigation from the wick
    //   (`top - last_low` for bull, `last_high - bottom` for bear). The engine
    //   defaults to CLOSE, which reports ~0% for a bar that wicked deep into the
    //   gap and closed back above it. Referencing ct.* here is fine: only `pe` is
    //   a type-resolution-only import (see the allowlist in
    //   tests/test_pine_library_import_permissions.py).
    [_bull_alert, _bear_alert, active_bull, active_bear, _new_bull, _new_bear, _bull_filled, _bear_filled, _bull_filled_new, _bear_filled_new, _bull_disc, _bear_disc] = eng.fvgs_objects(fill_mode = ct.LevelBreakMode.HIGHLOW, fill_target_ratio = FULL_MIT_PCT, size_threshold = size_threshold)

    [has_bull, bull_top, bull_bottom, bull_mit] = _newest_active_fvg(active_bull)
    [has_bear, bear_top, bear_bottom, bear_mit] = _newest_active_fvg(active_bear)

    int bull_count = na(active_bull) ? 0 : array.size(active_bull)
    int bear_count = na(active_bear) ? 0 : array.size(active_bear)

    bool bull_partial = has_bull and not na(bull_mit) and bull_mit >= PARTIAL_MIT_PCT
    bool bear_partial = has_bear and not na(bear_mit) and bear_mit >= PARTIAL_MIT_PCT

    // BPR: overlapping active bull + bear FVG.
    bool  bpr_active = false
    int   bpr_dir    = 0
    float bpr_top    = na
    float bpr_bottom = na
    if has_bull and has_bear
        float ot = math.min(bull_top, bear_top)
        float ob = math.max(bull_bottom, bear_bottom)
        if ot > ob
            bpr_active := true
            bpr_top    := ot
            bpr_bottom := ob
            bpr_dir    := close > (ot + ob) / 2.0 ? 1 : -1

    // Liquidity void: any active FVG >= 2% of mid-price (bull scanned first).
    float mid = (high + low) / 2.0
    [void_bull, void_bull_top, void_bull_bot] = _first_void(active_bull, mid, LIQ_VOID_MIN_SIZE_PCT)
    [void_bear, void_bear_top, void_bear_bot] = _first_void(active_bear, mid, LIQ_VOID_MIN_SIZE_PCT)
    bool  void_active = void_bull or void_bear
    float void_top    = void_bull ? void_bull_top : void_bear ? void_bear_top : na
    float void_bottom = void_bull ? void_bull_bot : void_bear ? void_bear_bot : na

    // Zone bias from active FVG count delta.
    int count_delta = bull_count - bear_count
    int zone_bias   = count_delta >= ZONE_BIAS_COUNT_DELTA ? 1 : count_delta <= -ZONE_BIAS_COUNT_DELTA ? -1 : 0

    // Composite precedence: BPR > VOID > FVG_BULL > FVG_BEAR > NONE.
    int state = bpr_active ? 3 : void_active ? 4 : has_bull ? 1 : has_bear ? 2 : 0

    ImbalanceFrame.new(has_bull, has_bear, has_bull ? bull_top : na, has_bull ? bull_bottom : na, has_bear ? bear_top : na, has_bear ? bear_bottom : na, has_bull ? bull_mit : na, has_bear ? bear_mit : na, bull_partial, bear_partial, bull_count, bear_count, bpr_active, bpr_dir, bpr_top, bpr_bottom, void_active, void_top, void_bottom, zone_bias, state)

// Build the zone frame (order-block lifecycle) from the engine's OB tracker.
// Standalone convenience facade: it detects structure once and feeds that same
// instance into track_obs, exactly as SMC_Long_Dip_Suite does (line 1740).
//
// NOTE for the aggregated build_context_frame() slice: do NOT call this next to
// build_structure_frame() — each public builder runs its own eng.detect_structure,
// so calling both spins up two independent structure state machines. The aggregator
// must detect once and call the private _build_zone seam directly.
//
// `swing_len` is the engine pivot length; `atr_len` / `min_mult` / `max_mult` are
// the ATR size filter. Their defaults MUST repeat ATR_LEN_MAIN /
// OB_FILTER_MIN_MULT / OB_FILTER_MAX_MULT as literals: Pine rejects a const as a
// parameter default — "The default value cannot be a function, variable or
// calculation" (CE10132) — so naming them here does not compile. The consts stay
// the documented source of these numbers; test_export_defaults_are_literals and
// test_zone_filter_defaults_match_their_consts keep the two in lockstep.
export build_zone_frame(simple int swing_len = 50, simple int atr_len = 50, float min_mult = 0.5, float max_mult = 2.5) =>
    [_trend, bull_bos, bull_choch, _top_x, _top_y, _trail_up_x, _trail_up, hh, bear_bos, bear_choch, _btm_x, _btm_y, _trail_dn_x, _trail_dn, swing_low, _hhll_x] = eng.detect_structure(swing_len)
    _build_zone(swing_len, hh, swing_low, bull_bos, bull_choch, bear_bos, bear_choch, atr_len, min_mult, max_mult)
