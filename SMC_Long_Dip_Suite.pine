bool market_regime_gate_ok_raw = index_gate_effective_ok and sector_gate_effective_ok and breadth_gate_effective_ok

[trend, bull_bos_alert, bull_choch_alert, top_x, top, trail_up_x, trail_up, hh, bear_bos_alert, bear_choch_alert, btm_x, btm, trail_dn_x, trail_dn, swing_low_struct, hhll_x] = eng.detect_structure(swing_length, filter_insignificant_internal_breaks = true)
// Separate display-only trend state: avoid exposing the engine's bullish bootstrap bias before a real structure break occurs.
bool bullish_structure_break = bull_bos_alert or bull_choch_alert
bool bearish_structure_break = bear_bos_alert or bear_choch_alert
bool structure_break_detected = bullish_structure_break or bearish_structure_break
int structure_break_since = ta.barssince(structure_break_detected)
int structure_display_trend = (not na(structure_break_since)) ? (trend) : (0)
bool bullish_trend_condition = structure_display_trend == 1
bool bearish_trend_condition = structure_display_trend == -1
bool live_exec = signal_mode == ct.SignalMode.AGGRESSIVE_LIVE and barstate.isrealtime
// Entry/exit state propagation uses confirmed bars unless the operator explicitly opts into aggressive live mode.
bool state_update_bar_ok = barstate.isconfirmed or signal_mode == ct.SignalMode.AGGRESSIVE_LIVE
// Signal propagation: pass the alert through on AGGRESSIVE_LIVE always, otherwise only on the confirmed bar.
resolve_confirmed_signal(bool alert_now) =>
    (signal_mode == ct.SignalMode.AGGRESSIVE_LIVE or barstate.isconfirmed) and alert_now
bool bull_bos_sig = resolve_confirmed_signal(bull_bos_alert)
bool bull_choch_sig = resolve_confirmed_signal(bull_choch_alert)
bool bear_bos_sig = resolve_confirmed_signal(bear_bos_alert)
bool bear_choch_sig = resolve_confirmed_signal(bear_choch_alert)
bool bullish_trend_safe = resolve_close_safe_bool(bullish_trend_condition)
bool bearish_trend_safe = resolve_close_safe_bool(bearish_trend_condition)
bool market_regime_gate_ok = resolve_close_safe_bool_gated(market_regime_gate_ok_raw)
bool vola_regime_gate_safe = resolve_close_safe_bool_gated(vola_regime_gate_ok)

