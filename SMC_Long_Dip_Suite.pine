int internal_structure_break_since = ta.barssince(internal_structure_break_detected)
int internal_display_trend = (not na(internal_structure_break_since)) ? (internal_trend) : (0)

var color bull_internal_css = color.new(bull_css, 78)
var color bear_internal_css = color.new(bear_css, 78)

var color long_color_reclaim = color_theme == 'Colorblind Safe' ? #17becf : color.orange

bool show_internal_bull_bos = show_internals and (show_bull == 'All' or show_bull == 'BOS')
bool show_internal_bull_choch = show_internals and (show_bull == 'All' or show_bull == 'CHoCH')

// Pivot labels (HH/LH/HL/LL)
bool show_swing_points_eff = show_swing_points and not compact_mode
if show_swing_points_eff
    eng.plot_pivot_points(1, top_x, top, show_swing_points_eff and not na(hh), d.LabelArgs.new(bear_css, #00000000, size = size.small, style = label.style_label_down), keep_history = keep_visual_history_eff)
    eng.plot_pivot_points(-1, btm_x, btm, show_swing_points_eff and not na(swing_low_struct), d.LabelArgs.new(bull_css, #00000000, size = size.small, style = label.style_label_up), keep_history = keep_visual_history_eff)

// UX-Fix:
