var g_micro = '14. Advanced - Ticker Microstructure'
var bool use_microstructure_profiles = input.bool(true, 'Use ticker microstructure profiles', group = g_micro, display = display.none)
string clean_reclaim_tickers_effective = mp.CLEAN_RECLAIM_TICKERS
string stop_hunt_tickers_effective = mp.STOP_HUNT_PRONE_TICKERS
string midday_dead_tickers_effective = mp.MIDDAY_DEAD_TICKERS
string rth_only_tickers_effective = mp.RTH_ONLY_TICKERS
string weak_premarket_tickers_effective = mp.WEAK_PREMARKET_TICKERS
string weak_afterhours_tickers_effective = mp.WEAK_AFTERHOURS_TICKERS
string fast_decay_tickers_effective = mp.FAST_DECAY_TICKERS
string current_symbol_key = syminfo.ticker
string current_symbol_key_qualified = syminfo.tickerid

// ── Library Freshness Check ──
// Renders the staleness warning label and returns the ASOF display string.
render_lib_freshness() =>
    asof_year  = str.tonumber(str.substring(mp.ASOF_DATE, 0, 4))
    asof_month = str.tonumber(str.substring(mp.ASOF_DATE, 5, 7))
    asof_day   = str.tonumber(str.substring(mp.ASOF_DATE, 8, 10))
    asof_ts    = timestamp(int(asof_year), int(asof_month), int(asof_day), 0, 0, 0)
    lib_days_old = math.floor((timenow - asof_ts) / 86400000)
    var label stale_label = na
    // T-1 cadence: ASOF_DATE stamps the last completed TRADING day and only
    // advances with the ~09-13Z refresh — weekend peak is ~4d13h, a Monday
    // holiday reaches floor 5. `> 2` warned every Monday on healthy data;
    // `> 5` mirrors the lo-pine-library-data-stale alert (432000s, #3878).
    if barstate.islast and lib_days_old > 5
        if not na(stale_label)
            label.delete(stale_label)
        stale_label := label.new(bar_index, high,
             "⚠️ Library " + str.tostring(lib_days_old) + "d alt — Indikator neu hinzufügen",
             color = color.red, textcolor = color.white,
             style = label.style_label_down, size = size.small)
    mp.ASOF_TIME != '' ? mp.ASOF_TIME : mp.ASOF_DATE

string lib_asof_display = render_lib_freshness()

// ── Regime / Event-Risk / Universe context (v5.5b canonical exports) ──
compute_lib_risk_context() =>
    // Regime Flags
    bool lib_regime_blocked = mp.MARKET_REGIME == "RISK_OFF" or mp.TRADE_STATE == "BLOCKED"
    bool lib_regime_dimmed  = mp.MARKET_REGIME == "ROTATION" or mp.TRADE_STATE == "DISCOURAGED"
    // Earnings / Macro Shield
    bool lib_has_earnings = u.csv_has_symbol_token(mp.EARNINGS_TODAY_TICKERS, current_symbol_key, current_symbol_key_qualified)
    // Universe Coverage — is this ticker covered by the enrichment scan?
    // Uses dedicated UNIVERSE_TICKERS field instead of heuristic across 7 lists (F7 fix).
    bool lib_universe_initialized = mp.UNIVERSE_TICKERS != ""
    bool lib_ticker_in_universe = lib_universe_initialized and u.csv_has_symbol_token(mp.UNIVERSE_TICKERS, current_symbol_key, current_symbol_key_qualified)
    // Market Valuation Flags
    bool lib_market_valuation_caution = mp.MARKET_PE_FORWARD > 0.0 and mp.MARKET_PE_REGIME == "EXPENSIVE" and mp.MACRO_BIAS_PE_ADJUSTMENT < 0.0
    // Event Risk Light (v5.5b canonical exports)
    string lib_erl_window_state    = mp.EVENT_WINDOW_STATE
    string lib_erl_level           = mp.EVENT_RISK_LEVEL
    bool   lib_erl_market_blocked  = mp.MARKET_EVENT_BLOCKED
    // SYMBOL_EVENT_BLOCKED is an aggregate producer flag: scope it back to
    // the current chart symbol using the accompanying exact-token list.
    bool   lib_erl_symbol_blocked  = mp.SYMBOL_EVENT_BLOCKED and (u.csv_has_symbol_token(mp.HIGH_RISK_EVENT_TICKERS, current_symbol_key, current_symbol_key_qualified) or u.csv_has_symbol_token(mp.EARNINGS_SOON_TICKERS, current_symbol_key, current_symbol_key_qualified))
    string lib_erl_provider_status = mp.EVENT_PROVIDER_STATUS
    // [v5.5 PRIMARY] event risk gate — single lean-derived hard block
    bool   event_risk_gate_ok      = not (lib_erl_market_blocked or lib_erl_symbol_blocked)
    // [v5.5 PRIMARY] event risk state: blocked / caution / clear — lean semantics only
    string event_risk_state        = eng.resolve_event_risk_state(lib_erl_market_blocked, lib_erl_symbol_blocked, lib_erl_window_state, lib_erl_level)
    // Earnings + Provider Transparency (WP-LF2)
    int    lib_provider_count = mp.PROVIDER_COUNT
    string lib_stale_providers = mp.STALE_PROVIDERS
    bool   lib_universe_partial_context = lib_ticker_in_universe and (lib_provider_count == 0 or lib_stale_providers != "" or lib_erl_provider_status != "ok")
    int    lib_universe_status_code = u.universe_status_code(lib_universe_initialized, lib_ticker_in_universe, lib_universe_partial_context)
    [lib_regime_blocked, lib_regime_dimmed, lib_has_earnings, lib_market_valuation_caution, lib_erl_window_state, lib_erl_level, lib_erl_market_blocked, lib_erl_symbol_blocked, lib_erl_provider_status, event_risk_gate_ok, event_risk_state, lib_provider_count, lib_stale_providers, lib_universe_status_code]

// ── v5.5 Lean Context [PRIMARY] — Session/OB/FVG/Structure/Signal-Quality lights ──
compute_lib_lean_context() =>
    // Session Context Light (v5.5b canonical exports)
    int    lib_scl_context_score = mp.SESSION_CONTEXT_SCORE
    // Order Block Context Light (v5.5a)
    string lib_obl_side  = mp.PRIMARY_OB_SIDE
    bool   lib_obl_fresh = mp.OB_FRESH
    // FVG Lifecycle Light (v5.5a)
    string lib_fvgl_side        = mp.PRIMARY_FVG_SIDE
    bool   lib_fvgl_invalidated = mp.FVG_INVALIDATED
    // Structure State Light (v5.5b canonical exports)
    int    lib_strl_trend_strength = mp.STRUCTURE_TREND_STRENGTH
    // Signal Quality (v5.5a)
    int    lib_sq_score          = mp.SIGNAL_QUALITY_SCORE
    string lib_sq_tier           = mp.SIGNAL_QUALITY_TIER
    string lib_sq_warnings       = mp.SIGNAL_WARNINGS
    string lib_sq_bias_alignment = mp.SIGNAL_BIAS_ALIGNMENT
    // Published resolver majors predate the v2 edge labels. Normalize at the
    // consumer boundary so very_fresh retains fresh trust and expired remains
    // fail-closed even before the next hand-authored library publication.
    string lib_sq_freshness_raw  = mp.SIGNAL_FRESHNESS
    string lib_sq_freshness      = lib_sq_freshness_raw == "very_fresh" ? "fresh" : lib_sq_freshness_raw == "expired" ? "stale" : lib_sq_freshness_raw
    // Volatility + Ensemble (v5.5b direct consumer bridge)
    string lib_ensemble_quality_tier = mp.ENSEMBLE_QUALITY_TIER
    // Signal Quality: generator-computed composite replaces ad-hoc checks
    bool signal_quality_ok   = lib_sq_score >= 25
    bool signal_quality_good = lib_sq_score >= 50
    bool signal_quality_high = lib_sq_score >= 75
    // Structure Light: trend strength from generator
    bool struct_light_trending = lib_strl_trend_strength >= 30
    // OB Context Light: primary OB is bullish + fresh
    bool ob_light_bull_ok = lib_obl_side == "BULL" and lib_obl_fresh
    // FVG Lifecycle Light: primary FVG alive + not invalidated
    bool fvg_light_active_ok = lib_fvgl_side != "NONE" and not lib_fvgl_invalidated
    // Session Context Light: lean session quality
    bool session_light_ok = lib_scl_context_score >= 2
    [lib_scl_context_score, lib_obl_side, lib_obl_fresh, lib_fvgl_side, lib_fvgl_invalidated, lib_strl_trend_strength, lib_sq_score, lib_sq_tier, lib_sq_warnings, lib_sq_bias_alignment, lib_sq_freshness, lib_ensemble_quality_tier, signal_quality_ok, signal_quality_good, signal_quality_high, struct_light_trending, ob_light_bull_ok, fvg_light_active_ok, session_light_ok]

// ── Market / Sector / News / Institutional per-ticker context ──
compute_lib_market_context() =>
    // Market Context (WP-LF1)
    float lib_vix_level = mp.VIX_LEVEL
    // Sector + Macro Context (WP-LF3)
    float lib_sector_breadth = mp.SECTOR_BREADTH
    float lib_macro_bias_raw = mp.MACRO_BIAS_RAW
    // Ticker Heat Map (WP-LF4)
    float lib_ticker_heat = cr.f_parse_ticker_heat(mp.TICKER_HEAT_MAP, syminfo.ticker)
    int   ticker_heat_adj = int(lib_ticker_heat * 20)
    // News Detail (WP-NW4/NW5)
    bool is_breaking_news = str.contains(mp.BREAKING_NEWS_TICKERS, syminfo.ticker)
    // WP-ND derived booleans (per-ticker): Short Interest (ND1) / Institutional (ND4)
    bool is_squeeze_risk      = str.contains(mp.SHORT_SQUEEZE_RISK_TICKERS, syminfo.ticker)
    bool is_inst_accumulation = str.contains(mp.INSTITUTIONAL_ACCUMULATION_TICKERS, syminfo.ticker)
    bool is_inst_distribution = str.contains(mp.INSTITUTIONAL_DISTRIBUTION_TICKERS, syminfo.ticker)
    [lib_vix_level, lib_sector_breadth, lib_macro_bias_raw, ticker_heat_adj, is_breaking_news, is_squeeze_risk, is_inst_accumulation, is_inst_distribution]

[lib_regime_blocked, lib_regime_dimmed, lib_has_earnings, lib_market_valuation_caution, lib_erl_window_state, lib_erl_level, lib_erl_market_blocked, lib_erl_symbol_blocked, lib_erl_provider_status, event_risk_gate_ok, event_risk_state, lib_provider_count, lib_stale_providers, lib_universe_status_code] = compute_lib_risk_context()
[lib_scl_context_score, lib_obl_side, lib_obl_fresh, lib_fvgl_side, lib_fvgl_invalidated, lib_strl_trend_strength, lib_sq_score, lib_sq_tier, lib_sq_warnings, lib_sq_bias_alignment, lib_sq_freshness, lib_ensemble_quality_tier, signal_quality_ok, signal_quality_good, signal_quality_high, struct_light_trending, ob_light_bull_ok, fvg_light_active_ok, session_light_ok] = compute_lib_lean_context()
[lib_vix_level, lib_sector_breadth, lib_macro_bias_raw, ticker_heat_adj, is_breaking_news, is_squeeze_risk, is_inst_accumulation, is_inst_distribution] = compute_lib_market_context()

