// Setup timing
var int long_signal_window = input.int(12, 'Signal Window Bars', minval = 1, group = g_long, inline = 'state1', display = display.none)
var int long_confirm_lookback = input.int(3, 'Confirm Break Lookback', minval = 1, maxval = 20, group = g_long, inline = 'state1', display = display.none)
