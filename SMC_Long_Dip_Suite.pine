plot(ltf_bull_share, 'BUS LtfBullShare', display = display.none)
plot(ltf_bias_hint, 'BUS LtfBiasHint', display = display.none)
plot(ltf_volume_delta, 'BUS LtfVolumeDelta', display = display.none)
plot(cr.pack_bus_counts(array.size(ob_blocks_bull), array.size(fvgs_bull)), 'BUS ObjectsCountPack', display = display.none)
// ── v5.5 Lean BUS Plots ──
plot(cr.resolve_bus_lean_pack_a(lib_sq_score, lib_sq_tier, lib_sq_freshness, lib_sq_bias_alignment, lib_erl_window_state, lib_erl_level, lib_erl_market_blocked, lib_erl_symbol_blocked, lib_strl_trend_strength, mp.STRUCTURE_FRESH, mp.STRUCTURE_LAST_EVENT), 'BUS LeanPackA', display = display.none)
plot(cr.resolve_bus_lean_pack_b(lib_obl_side, lib_obl_fresh, mp.OB_MITIGATION_STATE, lib_fvgl_side, mp.FVG_FRESH, lib_fvgl_invalidated, lib_scl_context_score, mp.IN_KILLZONE, mp.ENSEMBLE_QUALITY_SCORE, lib_ensemble_quality_tier, mp.VOLATILITY_REGIME, mp.VOLATILITY_MODEL_SOURCE), 'BUS LeanPackB', display = display.none)

// ── BUS Quickstart Preset (Plan 1.4 caveat resolution) ──
// Helpers live near the input declaration so the effective_* gate
// chain can consume them. The hidden plots below expose the same
// values as a stable contract for the dashboard and tests. RVOL is
// wired (effective_relvol_good chain); HTF bias / FVG quality / vol
// regime stay BUS-only until their consumer surfaces ship in Q3.
plot(preset_effective_class_code(quickstart_preset),       'BUS PresetClassCode',     display = display.none)
plot(preset_effective_rvol_min(quickstart_preset),         'BUS PresetRvolMin',       display = display.none)
