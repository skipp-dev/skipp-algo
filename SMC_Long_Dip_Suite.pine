type LongLifecycleState
    bool armed = false
    bool confirmed = false
    int arm_bar_index = na
    int confirm_bar_index = na
    float trigger = na
    float invalidation_level = na
    int entry_origin_source
    int backing_zone_kind
    int backing_zone_id = na
    int backing_zone_touch_count = 0
    int locked_source_kind
    int locked_source_id = na
    float locked_source_top = na
    float locked_source_bottom = na
    int locked_source_touch_count = 0
    int locked_source_last_touch_bar_index = na
    int setup_serial = 0
    string last_invalid_source = 'None'
    float last_invalid_level = na

method clear(LongLifecycleState this) =>
    this.armed := false
    this.confirmed := false
    this.arm_bar_index := na
    this.confirm_bar_index := na
    this.trigger := na
    this.invalidation_level := na
    this.entry_origin_source := LONG_SOURCE_NONE
    this.backing_zone_kind := LONG_SOURCE_NONE
    this.backing_zone_id := na
    this.backing_zone_touch_count := 0
    this.locked_source_kind := LONG_SOURCE_NONE
    this.locked_source_id := na
    this.locked_source_top := na
    this.locked_source_bottom := na
    this.locked_source_touch_count := 0
    this.locked_source_last_touch_bar_index := na
    this

method arm(LongLifecycleState this, int arm_bar_index, float trigger, float invalidation_level, int entry_origin_source, int backing_zone_kind, int backing_zone_id, int backing_zone_touch_count, int locked_source_kind, int locked_source_id, float locked_source_top, float locked_source_bottom, int locked_source_touch_count, int locked_source_last_touch_bar_index) =>
    this.armed := true
    this.confirmed := false
    this.arm_bar_index := arm_bar_index
    this.confirm_bar_index := na
    this.trigger := trigger
    this.invalidation_level := invalidation_level
    this.entry_origin_source := entry_origin_source
    this.backing_zone_kind := backing_zone_kind
    this.backing_zone_id := backing_zone_id
    this.backing_zone_touch_count := backing_zone_touch_count
    this.locked_source_kind := locked_source_kind
    this.locked_source_id := locked_source_id
    this.locked_source_top := locked_source_top
    this.locked_source_bottom := locked_source_bottom
    this.locked_source_touch_count := locked_source_touch_count
    this.locked_source_last_touch_bar_index := locked_source_last_touch_bar_index
    this.setup_serial += 1
    this

method confirm(LongLifecycleState this, int confirm_bar_index) =>
    this.confirmed := true
    this.confirm_bar_index := confirm_bar_index
    this

method sync_locked_tracking(LongLifecycleState this, int backing_zone_kind, int backing_zone_id, int locked_source_kind, int locked_source_id, float locked_source_top, float locked_source_bottom, int locked_source_touch_count, int locked_source_last_touch_bar_index) =>
    this.backing_zone_kind := backing_zone_kind
    this.backing_zone_id := backing_zone_id
    this.backing_zone_touch_count := locked_source_touch_count
    this.locked_source_kind := locked_source_kind
    this.locked_source_id := locked_source_id
    this.locked_source_top := locked_source_top
    this.locked_source_bottom := locked_source_bottom
    this.locked_source_touch_count := locked_source_touch_count
    this.locked_source_last_touch_bar_index := locked_source_last_touch_bar_index
    this

method invalidate(LongLifecycleState this, string reason, float level) =>
    this.last_invalid_source := reason
    this.last_invalid_level := level
    this.clear()

validate_long_state(LongLifecycleState st, bool enabled = true) =>
    if enabled
        if st.confirmed and not st.armed
            runtime.error('Long invariant failed: confirmed requires armed')
        if st.locked_source_kind == LONG_SOURCE_NONE and not na(st.locked_source_id)
            runtime.error('Long invariant failed: NONE source cannot carry id')
        if st.locked_source_kind != LONG_SOURCE_NONE and na(st.locked_source_id)
            runtime.error('Long invariant failed: source kind requires source id')
        if st.backing_zone_kind == LONG_SOURCE_NONE and not na(st.backing_zone_id)
            runtime.error('Long invariant failed: NONE backing zone cannot carry id')
        if st.backing_zone_kind != LONG_SOURCE_NONE and na(st.backing_zone_id) and eng.long_source_is_zone_kind(st.backing_zone_kind)
            runtime.error('Long invariant failed: zone backing kind requires zone id')

// Persistent long-setup storage must exist before the OB/FVG engines run so active backing zones can be protected from cleanup.
var LongLifecycleState long_state = LongLifecycleState.new(false, false, na, na, na, na, LONG_SOURCE_NONE, LONG_SOURCE_NONE, na, 0, LONG_SOURCE_NONE, na, na, na, 0, na, 0, 'None', na)
varip bool long_invalidated_this_bar = false

bool enable_ob_engine = use_ob_engine
int _ob_backing_zone_id = (long_state.backing_zone_kind == LONG_SOURCE_OB) ? (long_state.backing_zone_id) : (na)
[ob_blocks_bull, ob_blocks_bear, new_ob_bull, _new_ob_bear, ob_broken_bull, _ob_broken_bear, ob_broken_new_bull, _ob_broken_new_bear, ob_discarded_bull, _ob_discarded_bear] = eng.track_obs(swing_length, hh, swing_low_struct, bull_bos_alert, bull_choch_alert, bear_bos_alert, bear_choch_alert, ob_threshold_min, ob_threshold_max, enabled = enable_ob_engine, capture_profile = collect_ob_profile_current_bar, update_profile_current_bar = collect_ob_profile_current_bar, align_edge_to_value_area = use_ob_profile_effective, align_break_price_to_poc = use_ob_profile_effective, use_soft_confirm = use_ob_soft_confirm, soft_confirm_offset = soft_confirm_offset, keep_broken_max = ob_keep_broken_max, broken_by = active_break_mode, gc_cycle = object_gc_cycle_eff, protected_bull_id = _ob_backing_zone_id)

varip bool live_bull_ob_break = false
varip bool live_bull_fvg_fill = false

if barstate.isnew
    live_bull_ob_break := false
    live_bull_fvg_fill := false

if barstate.islast
    ob_blocks_bull.draw(ob_config_bull, visible_left = visible_left_time, visible_right = visible_right_time)

    if show_ob and ob_keep_broken and ob_keep_broken_max > 0
        ob_broken_bull.draw(ob_config_bull_broken, visible_left = visible_left_time, visible_right = visible_right_time)
    else
        ob_broken_bull.delete()

    if barstate.isconfirmed
        ob_discarded_bull.delete()
        array.clear(ob_discarded_bull)

var g_fvg = '26. Advanced - Fair Value Gaps'
var show_fvg = input.bool(true, 'Show Fair Value Gaps', group = g_fvg, inline = 'show', display = display.none, tooltip = 'Display fair value gaps on the chart.')
var fvg_showlast = input.int(DEFAULT_FVG_SHOW_LAST, 'Show last', minval = 1, group = g_fvg, inline = 'show2', active = show_fvg, display = display.none)
var fvg_extend_until_filled = input.bool(true, 'Extend until filled', group = g_fvg, inline = 'ext', display = display.none)
var fvg_keep_filled = input.bool(true, 'Keep filled', group = g_fvg, inline = 'keep filled', display = display.none)
var fvg_keep_filled_max = input.int(DEFAULT_KEEP_HISTORY, '', minval = 1, group = g_fvg, inline = 'keep filled', active = fvg_keep_filled, display = display.none)
var bull_fvg_css = input.color(color.new(#00ff68, 90), '', group = g_fvg, inline = 'show', active = show_fvg, display = display.none)
var bull_fvg_line_css = input.color(color.new(#00ff68, 25), '', group = g_fvg, inline = 'show', active = show_fvg, display = display.none)
var bull_fvg_css_filled = input.color(color.new(color.gray, 80), '', group = g_fvg, inline = 'keep filled', active = fvg_keep_filled, display = display.none)
var bull_fvg_line_css_filled = color.new(bull_fvg_css_filled, 50)

// ── Ticker Heat → FVG Opacity Modifier (WP-LF4) ──
if barstate.isfirst and ticker_heat_adj != 0
    bull_fvg_css := color.new(bull_fvg_css, math.max(5, math.min(95, color.t(bull_fvg_css) - ticker_heat_adj)))

// ── Breaking News → FVG Opacity Minimum (WP-NW5) ──
if barstate.isfirst and is_breaking_news
    bull_fvg_css := color.new(bull_fvg_css, math.min(95, color.t(bull_fvg_css) + 15))

// ── Institutional Confirmation → FVG Opacity Modifier (WP-ND4) ──
if barstate.isfirst and is_inst_accumulation
    bull_fvg_css := color.new(bull_fvg_css, math.max(5, color.t(bull_fvg_css) - 5))
if barstate.isfirst and is_inst_distribution
    bull_fvg_css := color.new(bull_fvg_css, math.min(95, color.t(bull_fvg_css) + 5))

var filter_insignificant_fvgs = input.bool(true, 'Filter: min size', group = g_fvg, inline = 'fvg_min', display = display.none, tooltip = 'Filter out fair value gaps that are too small to matter.')
var min_fvg_size_atr_len = input.int(ATR_LEN_MAIN, 'ATR Length', minval = 1, group = g_fvg, inline = 'fvg_min', active = filter_insignificant_fvgs, display = display.none)
var min_fvg_size_atr_mult = input.float(DEFAULT_FVG_MIN_SIZE_MULT, 'x', minval = 0, step = 0.1, group = g_fvg, inline = 'fvg_min', active = filter_insignificant_fvgs, display = display.none)
float fvg_size_threshold = (filter_insignificant_fvgs) ? (u.smc_lib_atr(min_fvg_size_atr_len) * min_fvg_size_atr_mult) : (0)
var float fvg_fill_target_pct = input.float(DEFAULT_FVG_FILL_TARGET_PCT, 'Filled at %', minval = 0, maxval = 100, step = 5, group = g_fvg, display = display.none)
float fvg_fill_target_ratio = math.max(0.0, math.min(1.0, fvg_fill_target_pct / 100.0))
var use_fvg_engine = input.bool(true, 'Use FVG engine', group = g_fvg, display = display.none, tooltip = 'Keeps FVG-based long-dip logic and alerts running even if chart rendering is hidden.')

bool enable_fvg_engine = use_fvg_engine
int _fvg_backing_zone_id = (long_state.backing_zone_kind == LONG_SOURCE_FVG) ? (long_state.backing_zone_id) : (na)
[bullish_fvg_alert, bearish_fvg_alert, fvgs_bull, fvgs_bear, new_fvg_bull, _new_fvg_bear, filled_fvgs_bull, _filled_fvgs_bear, filled_fvgs_new_bull, _filled_fvgs_new_bear, fvg_discarded_bull, fvg_discarded_bear] = eng.fvgs_objects(active_break_mode, fvg_fill_target_ratio, fvg_size_threshold, enable_fvg_engine, fvg_keep_filled_max, object_gc_cycle_eff, _fvg_backing_zone_id)

var fvg_config_bull = eng.FVGConfig.new(show_box = show_fvg, show_target = show_fvg, show_target_label = true, show_last = fvg_showlast, txt = 'FVG ⬈', show_quality_score = true, extend_until_filled = fvg_extend_until_filled, box_args = d.BoxArgs.new(bull_fvg_line_css, 0, line.style_solid, bull_fvg_css, xloc.bar_index), box_text_args = d.BoxTextArgs.new(bull_fvg_line_css, size.normal, text.align_right, text.align_center), line_args = d.LineArgs.new(bull_fvg_line_css, line.style_solid, 1, xloc.bar_index), label_args = d.LabelArgs.new(bull_fvg_line_css, xloc = xloc.bar_index, style = label.style_label_left, size = size.normal, text_align = text.align_left))
