var bool use_lean_context_gates = input.bool(false, 'Use Lean Context Consensus', tooltip = 'When enabled, Session/OB/FVG/Structure lean context must produce 2-of-4 consensus in addition to the primary Signal Quality gate.', group = g_quality, inline = 'q2', display = display.none)
var bool use_scoring_over_blocking = input.bool(false, 'Scoring over Blocking (v5.5)', tooltip = 'When enabled, SCORING-class gates (accel, sd, vol, stretch, ddvi) no longer hard-block at Ready. Instead, failures count as quality tier penalty. Gates still apply at Best/Strict tiers.', group = g_quality, inline = 'q3', display = display.none)
