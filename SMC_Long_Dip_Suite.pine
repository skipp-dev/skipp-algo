var bool vol_require_squeeze_for_ready = input.bool(false, 'Ready requires squeeze context', group = g_volreg, active = use_volatility_regime, display = display.none, tooltip = 'Stacked rollout recommendation: off. Ready already needs regime trend, momentum expansion, and spread expansion, so squeeze context is better reserved for tighter entry tiers.')
var bool vol_require_release_for_entry_best = input.bool(false, 'Entry Best requires squeeze release', group = g_volreg, active = use_volatility_regime, display = display.none)
var bool vol_require_release_for_entry_strict = input.bool(false, 'Entry Strict requires squeeze release', group = g_volreg, active = use_volatility_regime, display = display.none, tooltip = 'Stacked rollout recommendation: off. Strict already requires regime trend, rising slopes, expansion, acceleration, stretch, and DDVI/SD confluence, so mandatory squeeze release can make it unnecessarily rare.')

var g_stretch = '22. Advanced - Stretch / Mean Reversion Context'
var bool use_stretch_context = input.bool(true, 'Use stretch context', group = g_stretch, display = display.none, tooltip = 'Preset guide:\nStacked rollout = Watchlist lower-extreme off, Ready lower-extreme off, Best off, Strict on, anti-chase active.\nBalanced = turn Ready lower-extreme on if you want more genuine deep-pullback bias.\nTight = keep Strict at 0.00 or below and keep Best tied to lower-extreme context.')
var int stretch_len = input.int(100, 'Mean / StdDev length', minval = 20, group = g_stretch, inline = 'dist1', active = use_stretch_context, display = display.none, tooltip = 'Recommended start: 100. Shorter reacts faster, longer is smoother and more stable.')
var float lower_extreme_z = input.float(1.5, 'Lower extreme z', minval = 0.5, step = 0.1, group = g_stretch, inline = 'dist1', active = use_stretch_context, display = display.none, tooltip = 'Recommended start: 1.5. Higher values require deeper downside stretch before context turns favorable.')
var int lower_extreme_recent_bars = input.int(12, 'Lower extreme recent bars', minval = 1, maxval = 100, group = g_stretch, inline = 'dist2', active = use_stretch_context, display = display.none, tooltip = 'Recommended start: 12. This keeps stretch context alive briefly after the actual lower-extreme touch.')
var float anti_chase_max_z_ready = input.float(0.50, 'Ready max z', step = 0.1, group = g_stretch, inline = 'ac1', active = use_stretch_context, display = display.none, tooltip = 'Cautious rollout: 0.50. Higher values allow later rebounds to still qualify as Ready.')
var float anti_chase_max_z_best = input.float(0.25, 'Best max z', step = 0.1, group = g_stretch, inline = 'ac1', active = use_stretch_context, display = display.none, tooltip = 'Cautious rollout: 0.25. Keeps Entry Best closer to the original dip rather than a late mean chase.')
var float anti_chase_max_z_strict = input.float(0.00, 'Strict max z', step = 0.1, group = g_stretch, inline = 'ac1', active = use_stretch_context, display = display.none, tooltip = 'Cautious rollout: 0.00. Strict then only allows entries at or below the mean, not above it.')
var bool stretch_require_lower_extreme_for_ready = input.bool(false, 'Ready requires lower extreme context', group = g_stretch, active = use_stretch_context, display = display.none, tooltip = 'Stacked rollout recommendation: off. Keep anti-chase active for Ready, but reserve mandatory lower-extreme context for Entry Best and Entry Strict.')
var bool stretch_require_lower_extreme_for_entry_best = input.bool(false, 'Entry Best requires lower extreme context', group = g_stretch, active = use_stretch_context, display = display.none, tooltip = 'Stacked rollout recommendation: off. Anti-chase stays active, but Best no longer needs a fresh lower-extreme context on top of acceleration, DDVI, and regime filters.')
var bool stretch_require_lower_extreme_for_entry_strict = input.bool(true, 'Entry Strict requires lower extreme context', group = g_stretch, active = use_stretch_context, display = display.none, tooltip = 'Recommended on. Strict should stay fully tied to real lower-extreme mean-reversion setups.')

