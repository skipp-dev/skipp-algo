get_structure_display_trend_only(simple int structure_len) =>
    [trend, bull_bos_alert, bull_choch_alert, _, _, _, _, _, bear_bos_alert, bear_choch_alert, _, _, _, _, _, _] = eng.detect_structure(structure_len, filter_insignificant_internal_breaks = true)
    bool structure_break_detected = bull_bos_alert or bull_choch_alert or bear_bos_alert or bear_choch_alert
    not na(ta.barssince(structure_break_detected)) ? trend : 0

// HTF trend confirmation is sampled without lookahead so the dashboard state stays tied to closed HTF bars.
get_confirmed_structure_trend(string trend_tf, simple int structure_len) =>
    request.security(syminfo.tickerid, trend_tf, get_structure_display_trend_only(structure_len)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)


// T-1 (Temporal-Numerical Audit 2026-04-24): bar-close gate.
// Vorher: `alert.freq_all` + kein `barstate.isconfirmed`-Guard ließ dynamische
// Long-Alerts (Strict/Best/Ready/Confirmed/Clean/Early/Armed/Watchlist) intrabar
// feuern und mutierte `seen_keys` schon vor dem Close, wodurch ein
// Bar-Close-Alert dann unterdrückt wurde. Jetzt: nur am bestätigten Bar-Close.



resolve_ob_alert_level(eng.OrderBlock block) =>
    float level = na
    if not na(block)
        level := block.break_price
    level

resolve_fvg_alert_level(eng.FVG gap) =>
    float level = na
    if not na(gap)
        level := gap.fill_target_level
    level

// Overhead membership and overhead distance are two different questions and the
// scan used to answer both with one number. A bear zone is OVERHEAD while any
// part of it sits above the entry, i.e. while its far edge (`left_top.price`)
// is above the scan reference. How far the entry is from the reaction that zone
// produces is a separate quantity: the reaction level, deliberately the
// POC-aligned `break_price` resp. `fill_target_level` (see #4200).
// Those two can disagree. `long_trigger` is frozen at arm time and derived from
// wicks (`math.max(high, ta.highest(high, long_confirm_lookback)[1])`), while a
// zone only counts as consumed once price CLOSES through its reaction level in
// the default CONFIRMED_ONLY mode. A wick can therefore lift the entry above
// the reaction level of a zone that is still live, and such a zone used to drop
// out of the scan and block nothing. Membership now follows the far edge and
// the distance is clamped at the entry, so the zone reports zero clear headroom
// instead of vanishing. Zones entirely at or below the entry stay excluded
// exactly as before.
// Deliberately separate from `resolve_ob_alert_level` / `resolve_fvg_alert_level`:
// those also serve the alert and zone-scan paths, where the reaction level is
// the correct and only reference.
resolve_ob_overhead_level(eng.OrderBlock block, float scan_ref) =>
    float level = na
    if not na(block) and not na(block.left_top) and not na(scan_ref)
        float far_edge = block.left_top.price
        if not na(far_edge) and far_edge > scan_ref
            level := scan_ref
            float reaction = block.break_price
            if not na(reaction) and reaction > scan_ref
                level := reaction
    level

resolve_fvg_overhead_level(eng.FVG gap, float scan_ref) =>
    float level = na
    if not na(gap) and not na(gap.left_top) and not na(scan_ref)
        float far_edge = gap.left_top.price
        if not na(far_edge) and far_edge > scan_ref
            level := scan_ref
            float reaction = gap.fill_target_level
            if not na(reaction) and reaction > scan_ref
                level := reaction
    level


compute_long_overhead_context(bool long_plan_active, float close_price, float long_trigger, float long_invalidation_level, float ob_threshold_atr, float stop_buffer_atr_mult, eng.OrderBlock[] ob_blocks_bear_param, int bear_ob_scan_start, eng.FVG[] fvgs_bear_param, int bear_fvg_scan_start, bool use_overhead_zone_filter, float min_headroom_r) =>
    float helper_planned_stop_level = na
    if long_plan_active
        helper_planned_stop_level := long_invalidation_level - ob_threshold_atr * stop_buffer_atr_mult
    float helper_scan_ref = close_price
    if long_plan_active and not na(long_trigger)
        helper_scan_ref := long_trigger
    // BASELINE PHASE (2026-07-29, owner decision on #4205): both gates are
    // computed in one pass. The SERVED gate is the pre-#4205 reaction-level
    // scan (`resolve_*_alert_level`); the far-edge membership scan
    // (`resolve_*_overhead_level`) runs as an observe-only shadow so its flip
    // rate can be measured same-bar before it goes live. The activation
    // follow-up swaps the served/shadow tuple slots and drops the old scan.
    float helper_bear_ob_lvl = na
    float helper_bear_ob_lvl_fe = na
    if array.size(ob_blocks_bear_param) > 0
        for i = array.size(ob_blocks_bear_param) - 1 to bear_ob_scan_start
            helper_blocker = array.get(ob_blocks_bear_param, i)
            float helper_blocker_level = resolve_ob_alert_level(helper_blocker)
            if not na(helper_blocker_level) and helper_blocker_level >= helper_scan_ref and (na(helper_bear_ob_lvl) or helper_blocker_level < helper_bear_ob_lvl)
                helper_bear_ob_lvl := helper_blocker_level
            float helper_blocker_level_fe = resolve_ob_overhead_level(helper_blocker, helper_scan_ref)
            if not na(helper_blocker_level_fe) and helper_blocker_level_fe >= helper_scan_ref and (na(helper_bear_ob_lvl_fe) or helper_blocker_level_fe < helper_bear_ob_lvl_fe)
                helper_bear_ob_lvl_fe := helper_blocker_level_fe
    float helper_bear_fvg_lvl = na
    float helper_bear_fvg_lvl_fe = na
    if array.size(fvgs_bear_param) > 0
        for i = array.size(fvgs_bear_param) - 1 to bear_fvg_scan_start
            helper_fblocker = array.get(fvgs_bear_param, i)
            float helper_fblocker_level = resolve_fvg_alert_level(helper_fblocker)
            if not na(helper_fblocker_level) and helper_fblocker_level >= helper_scan_ref and (na(helper_bear_fvg_lvl) or helper_fblocker_level < helper_bear_fvg_lvl)
                helper_bear_fvg_lvl := helper_fblocker_level
            float helper_fblocker_level_fe = resolve_fvg_overhead_level(helper_fblocker, helper_scan_ref)
            if not na(helper_fblocker_level_fe) and helper_fblocker_level_fe >= helper_scan_ref and (na(helper_bear_fvg_lvl_fe) or helper_fblocker_level_fe < helper_bear_fvg_lvl_fe)
                helper_bear_fvg_lvl_fe := helper_fblocker_level_fe
    float helper_overhead_level = na
    if not na(helper_bear_ob_lvl) and not na(helper_bear_fvg_lvl)
        helper_overhead_level := math.min(helper_bear_ob_lvl, helper_bear_fvg_lvl)
    else
        helper_overhead_level := helper_bear_fvg_lvl
        if not na(helper_bear_ob_lvl)
            helper_overhead_level := helper_bear_ob_lvl
    float helper_overhead_level_fe = na
    if not na(helper_bear_ob_lvl_fe) and not na(helper_bear_fvg_lvl_fe)
        helper_overhead_level_fe := math.min(helper_bear_ob_lvl_fe, helper_bear_fvg_lvl_fe)
    else
        helper_overhead_level_fe := helper_bear_fvg_lvl_fe
        if not na(helper_bear_ob_lvl_fe)
            helper_overhead_level_fe := helper_bear_ob_lvl_fe
    float helper_planned_risk = na
    if long_plan_active and not na(helper_planned_stop_level)
        helper_planned_risk := math.max(long_trigger - helper_planned_stop_level, syminfo.mintick)
    float helper_headroom_to_overhead = na
    if long_plan_active and not na(helper_overhead_level)
        helper_headroom_to_overhead := helper_overhead_level - long_trigger
    bool helper_overhead_zone_ok = true
    if use_overhead_zone_filter and not na(helper_headroom_to_overhead) and not na(helper_planned_risk)
        helper_overhead_zone_ok := helper_headroom_to_overhead >= helper_planned_risk * min_headroom_r
    float helper_headroom_to_overhead_far_edge_shadow = na
    if long_plan_active and not na(helper_overhead_level_fe)
        helper_headroom_to_overhead_far_edge_shadow := helper_overhead_level_fe - long_trigger
    bool helper_overhead_zone_ok_far_edge_shadow = true
    if use_overhead_zone_filter and not na(helper_headroom_to_overhead_far_edge_shadow) and not na(helper_planned_risk)
        helper_overhead_zone_ok_far_edge_shadow := helper_headroom_to_overhead_far_edge_shadow >= helper_planned_risk * min_headroom_r
    [helper_planned_stop_level, helper_planned_risk, helper_headroom_to_overhead, helper_overhead_zone_ok, helper_headroom_to_overhead_far_edge_shadow, helper_overhead_zone_ok_far_edge_shadow]



compute_ddvi_context(bool use_context, bool close_safe_only, ct.SignalMode mode, simple int di_length, simple int advx_smooth, simple ct.SmcLibMovingAverage ma_select, simple int ma_len, simple ct.SmcLibMovingAverage bb_ma_select, simple int bb_len, float bb_mult, simple int pivot_left, simple int pivot_right, simple int div_min_range, simple int div_max_range, simple int eq_zone_len, simple float eq_zone_dev_mult, simple float eq_zone_atr_mult, int lower_extreme_lookback, bool use_hidden_bull, bool use_strong_bull) =>
    bool event_bar_ok = barstate.isconfirmed or (not close_safe_only and mode == ct.SignalMode.AGGRESSIVE_LIVE)
    [plus_raw, minus_raw, _] = u.smc_lib_dmi(di_length, advx_smooth)
    float value = u.smc_lib_get_ma(ma_select, plus_raw - minus_raw, ma_len)
    [_, _, lower_band] = u.smc_lib_bb(value, bb_len, bb_mult, bb_ma_select)
    [strong_bull_raw, _, _, _, _, _, hidden_bull_raw, _, _, _] = u.smc_lib_detect_divergence(value, pivot_left, pivot_right, div_min_range, div_max_range, low, high, eq_zone_len, eq_zone_dev_mult, eq_zone_atr_mult)
    bool value_cross_zero = ta.crossover(value, 0)
    bool value_cross_lower_band = ta.crossover(value, lower_band)
    bool bias_bull = use_context and not na(value) and value > 0
    bool bias_rising = use_context and not na(value) and not na(value[1]) and value > value[1]
    bool bias_cross_up = use_context and event_bar_ok and not na(value) and value_cross_zero
    bool bias_ok = bias_bull and bias_rising
    bool bias_transition_ok = bias_cross_up or bias_ok
    bool lower_extreme_now = use_context and not na(value) and not na(lower_band) and value <= lower_band
    int lower_extreme_since = ta.barssince(lower_extreme_now)
    bool lower_extreme_recent = use_context and not na(lower_extreme_since) and lower_extreme_since <= lower_extreme_lookback
    bool recover_from_lower_extreme = use_context and event_bar_ok and not na(value) and not na(lower_band) and value_cross_lower_band
    bool lower_extreme_context = lower_extreme_now or lower_extreme_recent or recover_from_lower_extreme
    bool hidden_bull_divergence = use_context and use_hidden_bull and hidden_bull_raw
    bool strong_bull_divergence = use_context and use_strong_bull and strong_bull_raw
    bool bull_divergence_any = hidden_bull_divergence or strong_bull_divergence
    bool watchlist_ok = not use_context or lower_extreme_context or bias_rising
    bool ready_ok = not use_context or recover_from_lower_extreme or (bias_rising and not lower_extreme_now)
    bool entry_best_ok = not use_context or (ready_ok and (bias_transition_ok or bull_divergence_any))
    bool entry_strict_ok = not use_context or (entry_best_ok and bias_ok and not lower_extreme_now)
    if close_safe_only and not barstate.isconfirmed and bar_index > 0
        watchlist_ok := watchlist_ok[1]
        ready_ok := ready_ok[1]
        entry_best_ok := entry_best_ok[1]
        entry_strict_ok := entry_strict_ok[1]
    bool watchlist_ok_safe = watchlist_ok
    bool ready_ok_safe = ready_ok
    bool entry_best_ok_safe = entry_best_ok
    bool entry_strict_ok_safe = entry_strict_ok
    if mode != ct.SignalMode.AGGRESSIVE_LIVE and not barstate.isconfirmed and bar_index > 0
        watchlist_ok_safe := watchlist_ok[1]
        ready_ok_safe := ready_ok[1]
        entry_best_ok_safe := entry_best_ok[1]
        entry_strict_ok_safe := entry_strict_ok[1]
    [bias_ok, bull_divergence_any, lower_extreme_context, watchlist_ok_safe, ready_ok_safe, entry_best_ok_safe, entry_strict_ok_safe]

resolve_ob_top_boundary(eng.OrderBlock block) =>
    float level = na
    if not na(block)
        level := block.left_top.price
    level

resolve_ob_bottom_boundary(eng.OrderBlock block) =>
    float level = na
    if not na(block)
        level := block.right_bottom.price
    level

resolve_fvg_top_boundary(eng.FVG gap) =>
    float level = na
    if not na(gap)
        level := gap.left_top.price
    level

resolve_fvg_bottom_boundary(eng.FVG gap) =>
    float level = na
    if not na(gap)
        level := gap.right_bottom.price
    level

resolve_ob_recency_index(eng.OrderBlock block) =>
    int idx = na
    if not na(block)
        idx := block.right_bottom.index
    idx

resolve_fvg_recency_index(eng.FVG gap) =>
    int idx = na
    if not na(gap)
        idx := gap.right_bottom.index
    idx

resolve_ob_id(eng.OrderBlock block) =>
    int val = na
    if not na(block)
        val := block.id
    val

resolve_fvg_id(eng.FVG gap) =>
    int val = na
    if not na(gap)
        val := gap.id
    val




var g_mode = '1. Core Setup'
var ct.SignalMode signal_mode = input.enum(ct.SignalMode.CONFIRMED_ONLY, 'Signal Mode', group = g_mode, tooltip = 'Choose between safer closed-bar confirmation and faster realtime updates. Confirmed only is the safer non-repainting mode. Aggressive live allows intrabar high/low driven updates and alerts, so states can change before candle close, are not fully reconstructable after reload, and should be treated as realtime-only until the bar confirms.', display = display.status_line)
var string long_user_preset = input.string('Standard', 'Trading Style', options = ['Easy', 'Standard', 'Pro'], group = g_mode, tooltip = 'Primary Lite operating layer. Easy keeps the long engine permissive and easier to operate. Standard preserves the current balanced workflow. Pro enables stricter lifecycle and execution gating for cleaner but rarer setups.', display = display.status_line)
var bool compact_mode = input.bool(true, 'Focus View', group = g_mode, tooltip = 'Default first-run surface for solo operation or sharing. Suppresses debug overlays and keeps a single decision-first surface. Engine logic is unchanged; only the visible surface is reduced.')
var string color_theme = input.string('Standard', 'Color Theme', options = ['Standard', 'Colorblind Safe'], group = g_mode, tooltip = 'Standard uses the classic red/green palette. Colorblind Safe replaces bull/bear colors with a blue/orange palette optimised for deuteranopia and protanopia. Warning/stale colors are unchanged.')

// ── Quickstart Presets (Plan 1.4) ─────────────────────────────
// Ticker-class presets seeded from the calibration benchmark
// (`zone_priority_calibration.json`). Selecting a preset publishes the
// active class on the status line so downstream consumers and the
// dashboard can read it; existing inputs stay user-editable so power
// users keep full control. Conditional `active=` gating of the
// individual inputs lands in W1 once the preset \u2192 input mapping is
// covered by tests.
//
//   MEGA_TECH      — AAPL, MSFT, GOOGL, NVDA, META, AMZN
//                    Recommend RVOL >= 1.3, tighter ETH window,
//                    htf_bias_min = 0.7, FVG quality gate = high.
//                    Calibration evidence: AMZN/1H Grade A
//                    (84% HR, ECE 0.035).
//   FIN_SERVICES   — JPM, BAC, GS, MS
//                    Recommend FOMC event-gate ON, earnings
//                    kill-switch ON, vol_regime threshold tighter.
//                    Calibration evidence: JPM/15m Grade A (82.6% HR).
//   ENERGY         — XOM, CVX, COP, OXY
//                    Recommend Vol-Regime default HIGH, OIL
//                    event-gate ON, larger ATR-based zones.
//                    Higher intraday vol — calibration uses regime split.
//   CUSTOM         — Existing inputs apply as-is (default).
var string quickstart_preset = input.string('Custom', 'Quickstart Preset', options = ['Custom', 'Mega-Cap US Tech', 'Financial Services', 'Energy'], group = g_mode, tooltip = 'Preset library. Pick a ticker class to load curated defaults backed by the calibration benchmark.\n\nMega-Cap US Tech (AAPL/MSFT/GOOGL/NVDA/META/AMZN) — RVOL >= 1.3, tight ETH window, FVG quality gate high. Evidence: AMZN/1H Grade A (84% HR, ECE 0.035).\n\nFinancial Services (JPM/BAC/GS/MS) — FOMC event-gate, earnings kill-switch, tighter vol threshold. Evidence: JPM/15m Grade A (82.6% HR).\n\nEnergy (XOM/CVX/COP/OXY) — Vol-Regime default HIGH, OIL event-gate, larger ATR zones.\n\nCustom keeps the existing inputs as-is.', display = display.status_line)

// Plan 1.4 W1 — effective-defaults helpers must be declared before
// their first consumer (the effective_relvol_good chain in the gate
// section). The matching BUS plots stay grouped with the rest of the
// BUS contract further down so the surface stays readable.
//
// Encoded values (see preset tooltip for evidence):
//   Mega-Cap US Tech    -> rvol_min 1.30, htf_bias_min 0.70, fvg_quality 2 (high), vol_regime_default 0 (NORMAL)
//   Financial Services  -> rvol_min 1.20, htf_bias_min 0.60, fvg_quality 1 (med),  vol_regime_default 0 (NORMAL)
//   Energy              -> rvol_min 1.10, htf_bias_min 0.55, fvg_quality 1 (med),  vol_regime_default 1 (HIGH)
//   Custom              -> 0/0/0/0 (consumers fall back to their own input defaults)
preset_effective_rvol_min(string preset) =>
    preset == 'Mega-Cap US Tech'   ? 1.30 : preset == 'Financial Services' ? 1.20 : preset == 'Energy' ? 1.10 : 0.0

preset_effective_htf_bias_min(string preset) =>
    preset == 'Mega-Cap US Tech'   ? 0.70 : preset == 'Financial Services' ? 0.60 : preset == 'Energy' ? 0.55 : 0.0

// Plan 1.4 W2 — Translate the float bias-min into the count of
// bullish HTFs (0..3) that the context-quality helper actually checks.
// Mapping: ceil(bias_min * 3). Custom returns 0 (no-op floor).
//   Energy 0.55 -> 2  (matches default)
//   Financial Services 0.60 -> 2  (matches default)
//   Mega-Cap US Tech 0.70 -> 3  (stricter than default; needs full HTF stack)
preset_effective_htf_align_count(string preset) =>
    int(math.ceil(preset_effective_htf_bias_min(preset) * 3.0))

preset_effective_fvg_quality_gate(string preset) =>
    preset == 'Mega-Cap US Tech'   ? 2 : preset == 'Financial Services' ? 1 : preset == 'Energy' ? 1 : 0

preset_effective_vol_regime_default(string preset) =>
    preset == 'Energy' ? 1 : 0

preset_effective_class_code(string preset) =>
    preset == 'Mega-Cap US Tech'   ? 1 : preset == 'Financial Services' ? 2 : preset == 'Energy' ? 3 : 0


