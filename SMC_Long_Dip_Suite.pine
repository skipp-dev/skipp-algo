bool internal_bull_choch_sig = resolve_confirmed_signal(internal_bull_choch_alert)
bool internal_bear_bos_sig = resolve_confirmed_signal(internal_bear_bos_alert)
bool internal_bear_choch_sig = resolve_confirmed_signal(internal_bear_choch_alert)

