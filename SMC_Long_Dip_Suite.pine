var bool sd_require_for_confirmed = input.bool(false, 'Require SD confluence for Confirmed', group = g_sd, active = use_sd_confluence, display = display.none)
var bool sd_require_for_ready = input.bool(true, 'Require SD confluence for Ready', group = g_sd, active = use_sd_confluence, display = display.none)
var bool sd_require_for_entry_best = input.bool(false, 'Require SD confluence for Entry Best', group = g_sd, active = use_sd_confluence, display = display.none, tooltip = 'Default off means Entry Best adds no extra SD gate beyond the Ready-stage SD requirement. Turn it on only if Best itself should demand fresh SD support.')
var bool sd_require_both_for_entry_strict = input.bool(true, 'Entry Strict requires BOTH signals', group = g_sd, active = use_sd_confluence, display = display.none, tooltip = 'Recommended on. Strict then needs both bullish divergence and oscillator higher lows.')
var bool sd_require_osc_rising_for_ready = input.bool(false, 'Ready requires oscillator rising', group = g_sd, active = use_sd_confluence, display = display.none, tooltip = 'Stacked rollout recommendation: off. Ready already checks acceleration, volatility expansion, and DDVI improvement, so forcing a second-derivative rise can over-harden the same momentum turn twice.')

