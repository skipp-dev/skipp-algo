if show_chart_swing_levels
    eng.plot_swing_levels(1, trail_up_x, trail_up, structure_display_trend, true, d.LabelArgs.new(bear_css, #00000000, size = size.small, style = label.style_label_left), d.LineArgs.new(bear_css, line.style_solid, 2), override_right_index = bar_index + 20)
    eng.plot_swing_levels(-1, trail_dn_x, trail_dn, structure_display_trend, true, d.LabelArgs.new(bull_css, #00000000, size = size.small, style = label.style_label_left), d.LineArgs.new(bull_css, line.style_solid, 2), override_right_index = bar_index + 20)

if show_bull_bos or show_bull_choch
