var int max_ltf_samples_per_bar = input.int(300, 'Max LTF Samples / Bar', minval = 10, maxval = 1000, group = g_perf, active = enable_ltf_sampling, display = display.none, tooltip = 'Additional guardrail for lower timeframe array size per chart bar.')

