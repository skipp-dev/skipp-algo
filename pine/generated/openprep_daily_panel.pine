    table.cell(t, 3, 0, "Regime", text_color = color.gray, bgcolor = hdr_bg, text_size = size.small)
    table.cell(t, 4, 0, PANEL_REGIME, text_color = txt_col, bgcolor = hdr_bg, text_size = size.small)
