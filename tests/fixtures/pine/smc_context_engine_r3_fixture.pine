g_fixture = "R3 deterministic fixture — TEST ONLY"
string fixture_case = input.string("R3-SWEEP-01", "Case", options = ["R3-SWEEP-01", "R3-SWEEP-02", "R3-SWEEP-03", "R3-SWEEP-04", "R3-SWEEP-05", "R3-POOL-01", "R3-POOL-02", "R3-SESSION-01", "R3-SESSION-02", "R3-SESSION-03", "R3-SESSION-04", "R3-SESSION-05", "R3-CONTEXT-01", "R3-CONTEXT-02", "R3-CONTEXT-03"], group = g_fixture)
int fixture_anchor = input.time(timestamp("20 Jul 2026 13:30 +0000"),
     "Fixture anchor (start Bar Replay before this bar)", group = g_fixture)

