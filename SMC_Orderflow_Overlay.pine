//@version=6

// Product role: companion_operator_only. Pro-only orderflow overlay outside the Lite default surface.

// ─────────────────────────────────────────────────────────────────
// SMC Orderflow Overlay — lightweight companion to SMC Core
//
// Visualizes flow qualifier fields from the v5.1 enrichment layer:
//   • Relative volume / activity / size bars
//   • Delta proxy indicator
//   • ATS state + spike markers
//   • Flow direction confirmation (long ok / short ok)
//
// Reads mp.* fields from the generated micro-profiles library.
// Keep on a separate pane — independent of trade signals.
// ─────────────────────────────────────────────────────────────────

indicator("SMC Orderflow Overlay", overlay = false, max_labels_count = 50)

import preuss_steffen/smc_micro_profiles_generated/405 as mp

// ── Inputs ──────────────────────────────────────────────────────

var g_fl = "Orderflow Overlay"
var bool show_rel_vol        = input.bool(true,  "Show relative volume bar",   group = g_fl)
var bool show_delta_proxy    = input.bool(true,  "Show delta proxy",           group = g_fl)
var bool show_ats_state      = input.bool(true,  "Show ATS state",             group = g_fl)
var bool show_flow_direction = input.bool(true,  "Show flow direction markers", group = g_fl)
var color col_bullish        = input.color(color.new(color.green, 30), "Bullish color",  group = g_fl)
var color col_bearish        = input.color(color.new(color.red, 30),   "Bearish color",  group = g_fl)
var color col_neutral        = input.color(color.new(color.gray, 50),  "Neutral color",  group = g_fl)

var g_fp = "Real Footprint (opt-in)"
var bool use_real_footprint = input.bool(false, "Use real footprint delta", group = g_fp, tooltip = "Jan-2026 request.footprint(): real buy/sell volume and delta from TradingView's footprint engine. OPT-IN because footprint data depends on your TradingView plan and symbol; without it the value stays na and this overlay behaves exactly as before. The delta proxy plot stays on — run both side by side to judge the proxy before trusting either.")
var int fp_ticks_per_row  = input.int(25,  "Ticks per row", minval = 1, group = g_fp, active = use_real_footprint)
var int fp_value_area_pct = input.int(70,  "Value area %",  minval = 1, maxval = 100, group = g_fp, active = use_real_footprint)
var int fp_imbalance_pct  = input.int(300, "Imbalance %",   minval = 1, group = g_fp, active = use_real_footprint)

// ── Library fields ──────────────────────────────────────────────

float  fl_rel_vol         = mp.REL_VOL
float  fl_rel_activity    = mp.REL_ACTIVITY
float  fl_delta_proxy_pct = mp.DELTA_PROXY_PCT
bool   fl_flow_long_ok    = mp.FLOW_LONG_OK
bool   fl_flow_short_ok   = mp.FLOW_SHORT_OK
string fl_ats_state       = mp.ATS_STATE
bool   fl_ats_spike_up    = mp.ATS_SPIKE_UP
bool   fl_ats_spike_down  = mp.ATS_SPIKE_DOWN

// Library freshness check (shared pattern across all companions)
var label stale_badge = na
if barstate.islast
    float asof_year  = str.tonumber(str.substring(mp.ASOF_DATE, 0, 4))
    float asof_month = str.tonumber(str.substring(mp.ASOF_DATE, 5, 7))
    float asof_day   = str.tonumber(str.substring(mp.ASOF_DATE, 8, 10))
    int asof_ts      = timestamp(int(asof_year), int(asof_month), int(asof_day))
    int days_old     = math.floor((timenow - asof_ts) / 86400000)
    if days_old > 2
        if not na(stale_badge)
            label.delete(stale_badge)
        stale_badge := label.new(bar_index, low,
            "⚠ Library " + str.tostring(days_old) + "d old",
            color = color.new(color.red, 40), textcolor = color.white,
            style = label.style_label_up, size = size.tiny)

// ── Relative volume plot ────────────────────────────────────────

color rv_color = fl_rel_vol >= 1.5 ? col_bullish : fl_rel_vol <= 0.5 ? col_bearish : col_neutral
plot(show_rel_vol ? fl_rel_vol : na, "RelVol", rv_color, 2, plot.style_columns)
hline(1.0, "RelVol Baseline", color.new(color.gray, 70), hline.style_dotted)

// ── Delta proxy ─────────────────────────────────────────────────

color dp_color = fl_delta_proxy_pct > 0 ? col_bullish : fl_delta_proxy_pct < 0 ? col_bearish : col_neutral
plot(show_delta_proxy ? fl_delta_proxy_pct : na, "Delta Proxy %", dp_color, 1, plot.style_histogram, display = display.pane)

// ── Real footprint delta (opt-in, Jan-2026 request.footprint) ───
// Same unit as the proxy: PERCENT of bar volume (DELTA_PROXY_PCT is percent —
// the status line prints it with '%'), hence the explicit ×100 on the raw
// delta/total fraction. na-guarded end to end: charts or plans without
// footprint data leave the line empty and the proxy untouched.
footprint fl_fp = use_real_footprint ? request.footprint(fp_ticks_per_row, fp_value_area_pct, fp_imbalance_pct) : na
float fl_fp_total     = na(fl_fp) ? na : footprint.total_volume(fl_fp)
float fl_fp_delta_pct = na(fl_fp) or not (fl_fp_total > 0) ? na : 100 * footprint.delta(fl_fp) / fl_fp_total
color dr_color = fl_fp_delta_pct > 0 ? col_bullish : fl_fp_delta_pct < 0 ? col_bearish : col_neutral
plot(use_real_footprint ? fl_fp_delta_pct : na, "Delta Real %", dr_color, 2, plot.style_line, display = display.pane)

// ── ATS state background ────────────────────────────────────────

color ats_bg = show_ats_state ?
     fl_ats_state == "ACCUMULATION" ? color.new(color.green, 90) :
     fl_ats_state == "DISTRIBUTION" ? color.new(color.red, 90)   :
     fl_ats_state == "TRANSITION"   ? color.new(color.yellow, 90) :
     na :
     na
bgcolor(ats_bg, title = "ATS State")

// ── ATS spike markers ──────────────────────────────────────────

plotshape(show_ats_state and fl_ats_spike_up,  "ATS Spike Up",   shape.triangleup,   location.bottom, col_bullish, size = size.tiny)
plotshape(show_ats_state and fl_ats_spike_down, "ATS Spike Down", shape.triangledown, location.top,    col_bearish, size = size.tiny)

// ── Flow direction markers ──────────────────────────────────────

plotchar(show_flow_direction and fl_flow_long_ok  ? 0 : na, "Flow Long OK",  "▲", location.bottom, col_bullish, size = size.tiny, display = display.all)
plotchar(show_flow_direction and fl_flow_short_ok ? 0 : na, "Flow Short OK", "▼", location.top,    col_bearish, size = size.tiny, display = display.all)

// ── Status line ─────────────────────────────────────────────────

string flow_summary = "RV:" + str.tostring(fl_rel_vol, "#.##") + " Δ:" + str.tostring(fl_delta_proxy_pct, "#.#") + "% ATS:" + fl_ats_state + (use_real_footprint and not na(fl_fp_delta_pct) ? " Δreal:" + str.tostring(fl_fp_delta_pct, "#.#") + "%" : "")

// Flow summary via label (plotchar char= only supports single characters)
var label flow_label = na
if barstate.islast
    if not na(flow_label)
        label.delete(flow_label)
    flow_label := label.new(bar_index, low,
        flow_summary,
        color = color.new(color.gray, 80), textcolor = color.white,
        style = label.style_label_up, size = size.tiny)

// Keep a simple plotchar for the status line (single char indicator)
plotchar(fl_flow_long_ok ? 1 : fl_flow_short_ok ? -1 : 0,
    "Flow Direction", "•", location.absolute,
    fl_flow_long_ok ? col_bullish : fl_flow_short_ok ? col_bearish : color.gray,
    size = size.tiny, display = display.status_line)
