//@version=6

// Hidden, domain-first Context BUS v3 producer.
// Contract: schema 8001, exactly 60 direct channels, four TradingView plot
// slots reserved.  This producer is observational and cannot gate Suite trades.
indicator("SMC Context Bus", overlay = false)

import preuss_steffen/smc_context_engine_private/4 as ctx

const int SCHEMA_VERSION = 8001

var g_build = "Context Builder"
swing_len = input.int(50, "Structure swing length", minval = 2, group = g_build)
fresh_bars = input.int(20, "Event freshness bars", minval = 1, group = g_build)
float fvg_size_threshold = input.float(0.0, "FVG size threshold", minval = 0.0, step = 0.1, group = g_build)
atr_len = input.int(50, "Order-block ATR length", minval = 2, group = g_build)
float ob_min_mult = input.float(0.5, "Order-block minimum ATR", minval = 0.0, step = 0.1, group = g_build)
float ob_max_mult = input.float(2.5, "Order-block maximum ATR", minval = 0.1, step = 0.1, group = g_build)
sweep_pivot_len = input.int(5, "Sweep pivot length", minval = 1, group = g_build)
sweep_volume_len = input.int(20, "Sweep volume length", minval = 1, group = g_build)
pool_pivot_len = input.int(5, "Pool pivot length", minval = 1, group = g_build)
float pool_tolerance_pct = input.float(0.1, "Pool tolerance %", minval = 0.01, step = 0.01, group = g_build)
pool_max_levels = input.int(20, "Pool candidate limit", minval = 2, maxval = 100, group = g_build)

ctx.ContextFrame frame = ctx.build_context_frame(
     swing_len, fresh_bars, fvg_size_threshold, atr_len, ob_min_mult,
     ob_max_mult, sweep_pivot_len, sweep_volume_len, pool_pivot_len,
     pool_tolerance_pct, pool_max_levels)

bool structure_available = frame.structure.trend != 0 or not na(frame.structure.support) or not na(frame.structure.resistance)
bool imbalance_available = frame.imbalance.state != 0
bool zone_available = frame.zone.state != 0
bool sweep_available = frame.sweep.fresh
bool pool_available = not na(frame.pool.buy_side_level) or not na(frame.pool.sell_side_level)
bool session_available = frame.session.session_code != 0
int availability_mask = (structure_available ? 1 : 0) +
     (imbalance_available ? 2 : 0) +
     (zone_available ? 4 : 0) +
     (sweep_available ? 8 : 0) +
     (pool_available ? 16 : 0) +
     (session_available ? 32 : 0)

var int confirmed_epoch = na
if barstate.isconfirmed
    confirmed_epoch := int(time_close / 1000)

bool ready = not na(confirmed_epoch) and frame.available_domains > 0

// Meta (4)
plot(SCHEMA_VERSION, "CTX SchemaVersion", display = display.none)
plot(ready ? 1 : 0, "CTX Ready", display = display.none)
plot(availability_mask, "CTX AvailabilityMask", display = display.none)
plot(confirmed_epoch, "CTX ConfirmedEpoch", display = display.none)

// Aggregate (3)
plot(frame.bias, "CTX Bias", display = display.none)
plot(frame.available_domains, "CTX AvailableDomains", display = display.none)
plot(frame.quality_score, "CTX QualityScore", display = display.none)

// Structure (7)
plot(frame.structure.trend, "CTX StructureTrend", display = display.none)
plot(frame.structure.bos ? 1 : 0, "CTX StructureBos", display = display.none)
plot(frame.structure.choch ? 1 : 0, "CTX StructureChoch", display = display.none)
plot(frame.structure.dir_event, "CTX StructureEventDirection", display = display.none)
plot(frame.structure.resistance, "CTX StructureResistance", display = display.none)
plot(frame.structure.support, "CTX StructureSupport", display = display.none)
plot(frame.structure.bars_since_event, "CTX StructureEventAgeBars", display = display.none)

// Imbalance (15)
plot(frame.imbalance.state, "CTX ImbalanceState", display = display.none)
plot(frame.imbalance.zone_bias, "CTX FvgBias", display = display.none)
plot(frame.imbalance.bull_fvg_active ? 1 : 0, "CTX BullFvgActive", display = display.none)
plot(frame.imbalance.bear_fvg_active ? 1 : 0, "CTX BearFvgActive", display = display.none)
plot(frame.imbalance.bull_fvg_top, "CTX BullFvgTop", display = display.none)
plot(frame.imbalance.bull_fvg_bottom, "CTX BullFvgBottom", display = display.none)
plot(frame.imbalance.bear_fvg_top, "CTX BearFvgTop", display = display.none)
plot(frame.imbalance.bear_fvg_bottom, "CTX BearFvgBottom", display = display.none)
plot(frame.imbalance.bpr_active ? 1 : 0, "CTX BprActive", display = display.none)
plot(frame.imbalance.bpr_dir, "CTX BprDirection", display = display.none)
plot(frame.imbalance.bpr_top, "CTX BprTop", display = display.none)
plot(frame.imbalance.bpr_bottom, "CTX BprBottom", display = display.none)
plot(frame.imbalance.liq_void_active ? 1 : 0, "CTX LiquidityVoidActive", display = display.none)
plot(frame.imbalance.liq_void_top, "CTX LiquidityVoidTop", display = display.none)
plot(frame.imbalance.liq_void_bottom, "CTX LiquidityVoidBottom", display = display.none)

// Zones (10)
plot(frame.zone.state, "CTX ZoneState", display = display.none)
plot(frame.zone.ob_bias, "CTX ObBias", display = display.none)
plot(frame.zone.bull_ob_top, "CTX BullObTop", display = display.none)
plot(frame.zone.bull_ob_bottom, "CTX BullObBottom", display = display.none)
plot(frame.zone.bear_ob_top, "CTX BearObTop", display = display.none)
plot(frame.zone.bear_ob_bottom, "CTX BearObBottom", display = display.none)
plot(frame.zone.bull_ob_new ? 1 : 0, "CTX BullObNew", display = display.none)
plot(frame.zone.bear_ob_new ? 1 : 0, "CTX BearObNew", display = display.none)
plot(frame.zone.bull_ob_broken ? 1 : 0, "CTX BullObBroken", display = display.none)
plot(frame.zone.bear_ob_broken ? 1 : 0, "CTX BearObBroken", display = display.none)

// Sweeps (7)
plot(frame.sweep.direction, "CTX SweepDirection", display = display.none)
plot(frame.sweep.sweep_type, "CTX SweepType", display = display.none)
plot(frame.sweep.zone_top, "CTX SweepZoneTop", display = display.none)
plot(frame.sweep.zone_bottom, "CTX SweepZoneBottom", display = display.none)
plot(frame.sweep.reclaim_active ? 1 : 0, "CTX SweepReclaimActive", display = display.none)
plot(frame.sweep.quality_score, "CTX SweepQualityScore", display = display.none)
plot(frame.sweep.bars_since_event, "CTX SweepEventAgeBars", display = display.none)

// Pools (6)
plot(frame.pool.buy_side_level, "CTX BuyPoolLevel", display = display.none)
plot(frame.pool.sell_side_level, "CTX SellPoolLevel", display = display.none)
plot(frame.pool.buy_side_strength, "CTX BuyPoolStrength", display = display.none)
plot(frame.pool.sell_side_strength, "CTX SellPoolStrength", display = display.none)
plot(frame.pool.magnet_direction, "CTX PoolMagnetDirection", display = display.none)
plot(frame.pool.imbalance, "CTX PoolImbalance", display = display.none)

// Session (8)
plot(frame.session.session_code, "CTX SessionCode", display = display.none)
plot(frame.session.in_killzone ? 1 : 0, "CTX SessionKillzone", display = display.none)
plot(frame.session.range_top, "CTX SessionRangeTop", display = display.none)
plot(frame.session.range_bottom, "CTX SessionRangeBottom", display = display.none)
plot(frame.session.opening_range_active ? 1 : 0, "CTX OpeningRangeActive", display = display.none)
plot(frame.session.opening_range_top, "CTX OpeningRangeTop", display = display.none)
plot(frame.session.opening_range_bottom, "CTX OpeningRangeBottom", display = display.none)
plot(frame.session.direction_bias, "CTX SessionDirection", display = display.none)
